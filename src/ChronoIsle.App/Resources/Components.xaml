<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="Card.Standard" TargetType="Border">
    <Setter Property="SnapsToDevicePixels" Value="False"/>
    <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled"/>
    <Setter Property="Background" Value="{DynamicResource Brush.Card}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.StrokeSoft}"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{StaticResource Radius.Card}"/><Setter Property="Padding" Value="{StaticResource Space.Card}"/>
  </Style>
  <Style x:Key="Card.Subtle" TargetType="Border" BasedOn="{StaticResource Card.Standard}">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}"/><Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
  </Style>
  <Style x:Key="Text.PageTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="24"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/></Style>
  <Style x:Key="Text.SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/></Style>
  <Style x:Key="Text.Secondary" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/><Setter Property="FontSize" Value="13"/></Style>
  <Style x:Key="Text.Tertiary" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}"/><Setter Property="FontSize" Value="12"/></Style>

  <Style x:Key="Notice.Success" TargetType="Border" BasedOn="{StaticResource Card.Subtle}"><Setter Property="BorderBrush" Value="{DynamicResource Brush.Success}"/></Style>
  <Style x:Key="Notice.Warning" TargetType="Border" BasedOn="{StaticResource Card.Subtle}"><Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}"/></Style>
  <Style x:Key="Notice.Error" TargetType="Border" BasedOn="{StaticResource Card.Subtle}"><Setter Property="BorderBrush" Value="{DynamicResource Brush.Danger}"/></Style>
</ResourceDictionary>
