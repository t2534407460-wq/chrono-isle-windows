<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="Card.Standard" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.Card}"/><Setter Property="BorderBrush" Value="{StaticResource Brush.Stroke}"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="{StaticResource Radius.Card}"/><Setter Property="Padding" Value="{StaticResource Space.Card}"/>
  </Style>
  <Style x:Key="Card.Subtle" TargetType="Border" BasedOn="{StaticResource Card.Standard}">
    <Setter Property="Background" Value="{StaticResource Brush.Surface}"/><Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
  </Style>
  <Style x:Key="Text.PageTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/></Style>
  <Style x:Key="Text.SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}"/></Style>
  <Style x:Key="Text.Secondary" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="Text.Tertiary" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Brush.TextTertiary}"/><Setter Property="FontSize" Value="11"/></Style>

  <Style x:Key="Notice.Success" TargetType="Border" BasedOn="{StaticResource Card.Subtle}"><Setter Property="BorderBrush" Value="{StaticResource Brush.Success}"/></Style>
  <Style x:Key="Notice.Warning" TargetType="Border" BasedOn="{StaticResource Card.Subtle}"><Setter Property="BorderBrush" Value="{StaticResource Brush.Warning}"/></Style>
  <Style x:Key="Notice.Error" TargetType="Border" BasedOn="{StaticResource Card.Subtle}"><Setter Property="BorderBrush" Value="{StaticResource Brush.Danger}"/></Style>
</ResourceDictionary>
