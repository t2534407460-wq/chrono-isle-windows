<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="Color.Window">#0C0E10</Color>
  <Color x:Key="Color.Island">#07090A</Color>
  <Color x:Key="Color.Card">#14181B</Color>
  <Color x:Key="Color.Surface">#1B2125</Color>
  <Color x:Key="Color.Control">#242C31</Color>
  <Color x:Key="Color.Hover">#303A41</Color>
  <Color x:Key="Color.TextPrimary">#F2F5F7</Color>
  <Color x:Key="Color.TextSecondary">#BAC5CE</Color>
  <Color x:Key="Color.TextTertiary">#96A4AF</Color>
  <Color x:Key="Color.Accent">#39C98B</Color>
  <Color x:Key="Color.AccentSoft">#18392C</Color>
  <Color x:Key="Color.Success">#39C98B</Color>
  <Color x:Key="Color.Warning">#DFAF57</Color>
  <Color x:Key="Color.Danger">#E76C72</Color>
  <Color x:Key="Color.Reminder">#A99BCD</Color>
  <Color x:Key="Color.Stroke">#303A40</Color>
  <Color x:Key="Color.StrokeSoft">#242D33</Color>

  <SolidColorBrush x:Key="Brush.Window" Color="{StaticResource Color.Window}"/>
  <SolidColorBrush x:Key="Brush.Island" Color="{StaticResource Color.Island}"/>
  <SolidColorBrush x:Key="Brush.Card" Color="{StaticResource Color.Card}"/>
  <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}"/>
  <SolidColorBrush x:Key="Brush.Control" Color="{StaticResource Color.Control}"/>
  <SolidColorBrush x:Key="Brush.Hover" Color="{StaticResource Color.Hover}"/>
  <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}"/>
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}"/>
  <SolidColorBrush x:Key="Brush.TextTertiary" Color="{StaticResource Color.TextTertiary}"/>
  <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}"/>
  <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}"/>
  <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}"/>
  <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}"/>
  <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}"/>
  <SolidColorBrush x:Key="Brush.Reminder" Color="{StaticResource Color.Reminder}"/>
  <SolidColorBrush x:Key="Brush.Stroke" Color="{StaticResource Color.Stroke}"/>
  <SolidColorBrush x:Key="Brush.StrokeSoft" Color="{StaticResource Color.StrokeSoft}"/>

  <SolidColorBrush x:Key="Brush.OnAccent" Color="#07090A"/>
  <SolidColorBrush x:Key="Brush.DangerSoft" Color="#352025"/>

  <CornerRadius x:Key="Radius.Window">16</CornerRadius>
  <CornerRadius x:Key="Radius.Card">14</CornerRadius>
  <CornerRadius x:Key="Radius.Control">9</CornerRadius>
  <CornerRadius x:Key="Radius.Button">10</CornerRadius>
  <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

  <Thickness x:Key="Space.Page">24</Thickness>
  <Thickness x:Key="Space.Card">18</Thickness>
  <Thickness x:Key="Space.CardLarge">20</Thickness>
  <Thickness x:Key="Space.Control">12,8</Thickness>
  <FontFamily x:Key="Font.UI">Microsoft YaHei UI, Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Clock">Segoe UI</FontFamily>
</ResourceDictionary>
