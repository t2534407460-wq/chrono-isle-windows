<Window x:Class="ChronoIsle.App.Views.LifeIslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ChronoIsle.App"
        xmlns:domain="clr-namespace:ChronoIsle.App.Services.Domain"
        xmlns:views="clr-namespace:ChronoIsle.App.Views"
        Width="294" SizeToContent="Height" Background="Transparent" AllowsTransparency="True"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        Topmost="True" Style="{StaticResource Window.Display}"
        UseLayoutRounding="True" AutomationProperties.AutomationId="LifeIslandWindow"
        SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
        MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave">
  <Window.Resources>
    <Style x:Key="IslandPrimary" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="{DynamicResource Brush.Stroke}"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Padding" Value="13,7"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Brush.Hover}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value=".78"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value=".42"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="IslandNetworkSpeedTestPrimary" TargetType="Button" BasedOn="{StaticResource IslandPrimary}">
      <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.Island}"/>
    </Style>
    <Style x:Key="IslandIcon" TargetType="Button" BasedOn="{StaticResource IslandPrimary}">
      <Setter Property="Background" Value="{DynamicResource Brush.Control}"/><Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke}"/><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="8,4"/>
    </Style>
    <Style x:Key="IslandComplete" TargetType="Button">
      <Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/><Setter Property="MinHeight" Value="24"/><Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.TextTertiary}"/><Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Circle" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource Brush.TextPrimary}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Circle" Property="Opacity" Value=".72"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="IslandType" TargetType="Button" BasedOn="{StaticResource IslandPrimary}">
      <Setter Property="Background" Value="{DynamicResource Brush.Control}"/><Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke}"/><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="10,5"/>
    </Style>
    <Style x:Key="IslandQuick" TargetType="Button" BasedOn="{StaticResource IslandType}">
      <Setter Property="FontSize" Value="13"/><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="0,0,6,6"/>
    </Style>
    <Style x:Key="IslandDeleteButton" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
      <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}"/><Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
    </Style>
    <Style x:Key="IslandTab" TargetType="Button" BasedOn="{StaticResource IslandType}">
      <Setter Property="MinHeight" Value="31"/><Setter Property="Padding" Value="10,6"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="CollapsedHeaderButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="IslandDay" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="9" BorderBrush="Transparent" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Brush.Control}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value=".76"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="IslandTextInput" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="Background" Value="{DynamicResource Brush.Control}"/><Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/><Setter Property="CaretBrush" Value="{DynamicResource Brush.TextPrimary}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Grid Background="Transparent">
              <Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Style="{StaticResource Border.SmoothDecoration}"/>
              <Border BorderThickness="{TemplateBinding BorderThickness}" RenderOptions.ClearTypeHint="Enabled">
                <ScrollViewer x:Name="PART_ContentHost" Background="Transparent"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource Brush.TextTertiary}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="IslandSelect" TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/><Setter Property="Background" Value="{DynamicResource Brush.Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/><Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                  <Border x:Name="Item" Background="Transparent" CornerRadius="6">
                    <ContentPresenter Margin="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource Brush.Stroke}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource Brush.Hover}"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Foreground="{TemplateBinding Foreground}" Focusable="False"
                            IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="11,0">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
                        <ContentPresenter Grid.Column="0" Content="{Binding SelectionBoxItem,RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                          VerticalAlignment="Center" TextElement.Foreground="{DynamicResource Brush.TextPrimary}"/>
                        <Path Grid.Column="1" Data="M 1 1 L 5 5 L 9 1" Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="10" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1" CornerRadius="10" Margin="0,5,0,0" MinWidth="{TemplateBinding ActualWidth}">
                  <ScrollViewer MaxHeight="220"><ItemsPresenter/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="IslandContextMenu" TargetType="{x:Type ContextMenu}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HasDropShadow" Value="False"/>
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI Variable"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ContextMenu}">
            <Border Background="{DynamicResource Brush.Island}" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1"
                    CornerRadius="14" Padding="6" SnapsToDevicePixels="True">
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="IslandContextMenuItem" TargetType="{x:Type MenuItem}">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="MinWidth" Value="210"/>
      <Setter Property="Padding" Value="11,0"/>
      <Setter Property="Margin" Value="0,1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type MenuItem}">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                <Border x:Name="CheckBoxSurface" Grid.Column="1" Width="18" Height="18" Margin="10,0,0,0"
                        Background="{DynamicResource Brush.Control}" BorderBrush="{DynamicResource Brush.TextSecondary}"
                        BorderThickness="1.25" CornerRadius="5" Visibility="Collapsed" SnapsToDevicePixels="True">
                  <TextBlock x:Name="CheckMark" Text="✓" Foreground="{DynamicResource Brush.Island}" FontSize="12" FontWeight="Bold"
                             HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Border>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.Control}"/></Trigger>
              <Trigger Property="IsCheckable" Value="True">
                <Setter TargetName="CheckBoxSurface" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                <Setter TargetName="CheckBoxSurface" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                <Setter TargetName="CheckBoxSurface" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".42"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="IslandContextMenuSeparator" TargetType="{x:Type Separator}">
      <Setter Property="Margin" Value="10,5"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type Separator}"><Border Height="1" Background="{DynamicResource Brush.Control}"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="NavigationButton" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
      <Setter Property="Width" Value="38"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style x:Key="CopyButton" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
    </Style>
    <Style x:Key="ToolResultText" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="ContextMenu">
        <Setter.Value>
          <ContextMenu Style="{StaticResource IslandContextMenu}">
            <MenuItem Header="复制" InputGestureText="Ctrl+C" Style="{StaticResource IslandContextMenuItem}" Command="ApplicationCommands.Copy" CommandTarget="{Binding PlacementTarget,RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
          </ContextMenu>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ResultRow" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.Card}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="Margin" Value="0,0,0,7"/>
    </Style>
    <Geometry x:Key="MediaPreviousGeometry">M3,3 H5 V13 H3 Z M13,3 L6,8 L13,13 Z</Geometry>
    <Geometry x:Key="MediaNextGeometry">M11,3 H13 V13 H11 Z M3,3 L10,8 L3,13 Z</Geometry>
    <Geometry x:Key="MediaPlayGeometry">M4,2 L13,8 L4,14 Z</Geometry>
    <Geometry x:Key="MediaPauseGeometry">M4,2 H7 V14 H4 Z M10,2 H13 V14 H10 Z</Geometry>
  </Window.Resources>
  <Grid x:Name="Outer" Margin="8,8,8,11">
    <Border x:Name="MainBorder" Background="{DynamicResource Brush.Island}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="24">
      <Grid x:Name="IslandLayout">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="Header" Grid.Row="0" Height="43" Background="Transparent" Cursor="Hand" PreviewMouseLeftButtonDown="Header_MouseDown" PreviewMouseMove="Header_MouseMove" PreviewMouseLeftButtonUp="Header_MouseUp">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid x:Name="DefaultHeaderLeft" VerticalAlignment="Center" Margin="14,0,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid x:Name="MascotArea" Width="48" Height="30">
              <Button x:Name="MascotButton" AutomationProperties.AutomationId="IslandExpandButton" Width="48" Height="30" Padding="0" Background="Transparent" BorderThickness="0" Focusable="False" IsHitTestVisible="False">
                <Button.Template><ControlTemplate TargetType="Button"><Image Source="pack://application:,,,/ChronoIsle;component/Assets/island-mascot.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="False"/></ControlTemplate></Button.Template>
              </Button>
              <Ellipse x:Name="StatusLight" Width="8" Height="8" IsHitTestVisible="False"
                       Fill="{DynamicResource Brush.Success}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0"/>
            </Grid>
            <Button x:Name="AgendaSummaryButton" Grid.Column="1"
                    AutomationProperties.AutomationId="IslandAgendaButton"
                    Style="{StaticResource CollapsedHeaderButton}" HorizontalContentAlignment="Stretch" IsHitTestVisible="False">
              <DockPanel x:Name="SummaryWidgets" LastChildFill="True" Margin="7,1,6,0" VerticalAlignment="Center">
                <!-- Reserve each text slot so refreshes cannot resize or reposition the island. -->
                <TextBlock x:Name="FpsSummary" DockPanel.Dock="Right" Width="48" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12"
                           Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="MemoryUsageSummary" DockPanel.Dock="Right" Width="62" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12"
                           Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="CpuUsageSummary" DockPanel.Dock="Right" Width="62" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12"
                           Margin="6,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="NetworkSpeedSummary" DockPanel.Dock="Right" Width="144" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12"
                           Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="Summary" Width="144" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
            </Button>
          </Grid>
          <StackPanel x:Name="ClockGroup" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,13,0">
            <Button x:Name="NetworkStatusLight" AutomationProperties.AutomationId="IslandNetworkStatusButton"
                    Style="{StaticResource CollapsedHeaderButton}" Margin="0,0,6,0"
                    VerticalAlignment="Center" IsHitTestVisible="False">
              <Viewbox Width="14" Height="14" Stretch="Uniform">
                <Path x:Name="NetworkStatusGlyph"
                      Data="{StaticResource Icon.NetworkGlobe}"
                      Stroke="{DynamicResource Brush.Success}" StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" Fill="Transparent"/>
              </Viewbox>
            </Button>
            <TextBlock x:Name="NetworkLatencySummary" Text="-- ms" Visibility="Collapsed"
                       Width="44" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource Brush.TextSecondary}" FontSize="12"
                       Margin="0,0,6,0" VerticalAlignment="Center"/>
            <Button x:Name="ClockButton" AutomationProperties.AutomationId="IslandClockButton"
                    Style="{StaticResource CollapsedHeaderButton}" IsHitTestVisible="False">
              <TextBlock x:Name="Clock" Width="62" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="15"
                         FontFamily="{StaticResource Font.Clock}" FontWeight="Bold" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" Margin="0,0,6,0"/>
            </Button>
            <TextBlock x:Name="ExpandIndicator" Text="›" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="20" VerticalAlignment="Center" RenderTransformOrigin=".5,.5"><TextBlock.RenderTransform><RotateTransform x:Name="ChevronRotate" Angle="0"/></TextBlock.RenderTransform></TextBlock>
          </StackPanel>
          <Grid x:Name="CollapsedMedia" Grid.ColumnSpan="2" Margin="10,0" Visibility="Collapsed" Panel.ZIndex="5">
            <Grid x:Name="CollapsedMediaTrack" Background="Transparent" MouseEnter="CollapsedMediaTrack_MouseEnter" MouseLeave="CollapsedMediaTrack_MouseLeave">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="104"/>
              </Grid.ColumnDefinitions>
              <Grid Width="32" Height="32" VerticalAlignment="Center">
                <Ellipse Fill="{DynamicResource Brush.Control}"/>
                <Image x:Name="CollapsedMediaArtwork" Width="32" Height="32" Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True">
                  <Image.Clip><EllipseGeometry Center="16,16" RadiusX="16" RadiusY="16"/></Image.Clip>
                </Image>
                <TextBlock x:Name="CollapsedMediaArtworkPlaceholder" Text="♪" Foreground="{DynamicResource Brush.TextTertiary}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
              <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center">
                <TextBlock x:Name="CollapsedMediaTitle" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="CollapsedMediaArtist" Foreground="{DynamicResource Brush.TextTertiary}" FontSize="9" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
              </StackPanel>
              <Button x:Name="CollapsedMediaTrackButton" Grid.Column="2" Width="72" Height="34"
                      Style="{StaticResource CollapsedHeaderButton}" Background="Transparent"
                      Click="CollapsedMediaTrackButton_Click"

                      AutomationProperties.Name="实时音轨，悬浮显示播放控制">
                <Button.RenderTransform><TranslateTransform x:Name="CollapsedMediaTrackTranslate"/></Button.RenderTransform>
                <Border Width="70" Height="34" CornerRadius="15" Background="Transparent"
                        BorderThickness="0" SnapsToDevicePixels="False">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Height="34" Margin="0" UseLayoutRounding="False">
                    <Border x:Name="CollapsedSpectrum0" Width="4" Height="4" CornerRadius="2" Margin="2,0" Background="{DynamicResource Brush.Accent}" Opacity=".68" VerticalAlignment="Center" SnapsToDevicePixels="False"/>
                    <Border x:Name="CollapsedSpectrum1" Width="4" Height="4" CornerRadius="2" Margin="2,0" Background="{DynamicResource Brush.Accent}" Opacity=".84" VerticalAlignment="Center" SnapsToDevicePixels="False"/>
                    <Border x:Name="CollapsedSpectrum2" Width="4" Height="4" CornerRadius="2" Margin="2,0" Background="{DynamicResource Brush.Accent}" VerticalAlignment="Center" SnapsToDevicePixels="False"/>
                    <Border x:Name="CollapsedSpectrum3" Width="4" Height="4" CornerRadius="2" Margin="2,0" Background="{DynamicResource Brush.Accent}" Opacity=".84" VerticalAlignment="Center" SnapsToDevicePixels="False"/>
                    <Border x:Name="CollapsedSpectrum4" Width="4" Height="4" CornerRadius="2" Margin="2,0" Background="{DynamicResource Brush.Accent}" Opacity=".68" VerticalAlignment="Center" SnapsToDevicePixels="False"/>
                  </StackPanel>
                </Border>
              </Button>
              <StackPanel x:Name="CollapsedMediaControls" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
              <StackPanel.RenderTransform><TranslateTransform x:Name="CollapsedMediaControlsTranslate"/></StackPanel.RenderTransform>
              <Button x:Name="CollapsedMediaPrevious" Click="MediaPrevious_Click" Style="{StaticResource IslandIcon}" Width="28" Height="28" Padding="0">
                <Button.RenderTransform><TranslateTransform x:Name="CollapsedMediaPreviousTranslate"/></Button.RenderTransform>
                <Viewbox Width="12" Height="12">
                  <Path Data="{StaticResource MediaPreviousGeometry}" Fill="{DynamicResource Brush.TextPrimary}" Stretch="Uniform"/>
                </Viewbox>
              </Button>
              <Button x:Name="CollapsedMediaPlayPause" Click="MediaPlayPause_Click" Style="{StaticResource IslandIcon}" Width="30" Height="30" Padding="0" Margin="3,0">
