                  <TextBox.ContextMenu>
                    <ContextMenu Style="{StaticResource IslandContextMenu}">
                      <MenuItem Header="剪切" Style="{StaticResource IslandContextMenuItem}" Command="ApplicationCommands.Cut" CommandTarget="{Binding PlacementTarget,RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                      <MenuItem Header="复制" Style="{StaticResource IslandContextMenuItem}" Command="ApplicationCommands.Copy" CommandTarget="{Binding PlacementTarget,RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
                      <MenuItem Header="粘贴" Style="{StaticResource IslandContextMenuItem}" Command="ApplicationCommands.Paste" CommandTarget="{Binding PlacementTarget,RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"/>
