<Window x:Class="ChronoIsle.App.Views.LifeIslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ChronoIsle.App"
        Width="294" SizeToContent="Height" Background="Transparent" AllowsTransparency="True"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        UseLayoutRounding="True" AutomationProperties.AutomationId="LifeIslandWindow"
        SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
        MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave">
  <Window.Resources>
    <Style x:Key="IslandPrimary" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="{DynamicResource Brush.Stroke}"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Padding" Value="13,7"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="11">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Brush.Hover}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value=".78"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value=".42"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="IslandNetworkSpeedTestPrimary" TargetType="Button" BasedOn="{StaticResource IslandPrimary}">
      <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.Island}"/>
    </Style>
    <Style x:Key="IslandIcon" TargetType="Button" BasedOn="{StaticResource IslandPrimary}">
      <Setter Property="Background" Value="{DynamicResource Brush.Control}"/><Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke}"/><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="8,4"/>
    </Style>
    <Style x:Key="IslandComplete" TargetType="Button">
      <Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/><Setter Property="MinHeight" Value="24"/><Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.TextTertiary}"/><Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Circle" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource Brush.TextPrimary}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Circle" Property="Opacity" Value=".72"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="IslandType" TargetType="Button" BasedOn="{StaticResource IslandPrimary}">
      <Setter Property="Background" Value="{DynamicResource Brush.Control}"/><Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke}"/><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="10,5"/>
    </Style>
    <Style x:Key="IslandQuick" TargetType="Button" BasedOn="{StaticResource IslandType}">
      <Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="0,0,6,6"/>
    </Style>
    <Style x:Key="IslandDeleteButton" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
      <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="#2B272E"/><Setter Property="Foreground" Value="#E5A2AA"/>
    </Style>
    <Style x:Key="IslandTab" TargetType="Button" BasedOn="{StaticResource IslandType}">
      <Setter Property="MinHeight" Value="31"/><Setter Property="Padding" Value="12,6"/><Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="CollapsedHeaderButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="IslandDay" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="9" BorderBrush="Transparent" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Brush.Control}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value=".76"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="IslandTextInput" TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource Brush.Control}"/><Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/><Setter Property="CaretBrush" Value="{DynamicResource Brush.TextPrimary}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ScrollViewer x:Name="PART_ContentHost"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource Brush.TextTertiary}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="IslandSelect" TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/><Setter Property="Background" Value="{DynamicResource Brush.Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="ItemContainerStyle">
        <Setter.Value>
          <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/><Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                  <Border x:Name="Item" Background="Transparent" CornerRadius="6">
                    <ContentPresenter Margin="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource Brush.Stroke}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource Brush.Hover}"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Foreground="{TemplateBinding Foreground}" Focusable="False"
                            IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                            Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="11,0">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
                        <ContentPresenter Grid.Column="0" Content="{Binding SelectionBoxItem,RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                          VerticalAlignment="Center" TextElement.Foreground="{DynamicResource Brush.TextPrimary}"/>
                        <Path Grid.Column="1" Data="M 1 1 L 5 5 L 9 1" Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Width="10" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1" CornerRadius="10" Margin="0,5,0,0" MinWidth="{TemplateBinding ActualWidth}">
                  <ScrollViewer MaxHeight="220"><ItemsPresenter/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="IslandContextMenu" TargetType="{x:Type ContextMenu}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HasDropShadow" Value="False"/>
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI Variable"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ContextMenu}">
            <Border Background="{DynamicResource Brush.Island}" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1"
                    CornerRadius="14" Padding="6" SnapsToDevicePixels="True">
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="IslandContextMenuItem" TargetType="{x:Type MenuItem}">
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="MinWidth" Value="210"/>
      <Setter Property="Padding" Value="11,0"/>
      <Setter Property="Margin" Value="0,1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type MenuItem}">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9"
                    Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                <Border x:Name="CheckBoxSurface" Grid.Column="1" Width="18" Height="18" Margin="10,0,0,0"
                        Background="{DynamicResource Brush.Control}" BorderBrush="{DynamicResource Brush.TextSecondary}"
                        BorderThickness="1.25" CornerRadius="5" Visibility="Collapsed" SnapsToDevicePixels="True">
                  <TextBlock x:Name="CheckMark" Text="✓" Foreground="{DynamicResource Brush.Island}" FontSize="12" FontWeight="Bold"
                             HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                </Border>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.Control}"/></Trigger>
              <Trigger Property="IsCheckable" Value="True">
                <Setter TargetName="CheckBoxSurface" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                <Setter TargetName="CheckBoxSurface" Property="Background" Value="{DynamicResource Brush.Accent}"/>
                <Setter TargetName="CheckBoxSurface" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".42"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="IslandContextMenuSeparator" TargetType="{x:Type Separator}">
      <Setter Property="Margin" Value="10,5"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type Separator}"><Border Height="1" Background="{DynamicResource Brush.Control}"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Geometry x:Key="MediaPreviousGeometry">M3,3 H5 V13 H3 Z M13,3 L6,8 L13,13 Z</Geometry>
    <Geometry x:Key="MediaNextGeometry">M11,3 H13 V13 H11 Z M3,3 L10,8 L3,13 Z</Geometry>
    <Geometry x:Key="MediaPlayGeometry">M4,2 L13,8 L4,14 Z</Geometry>
    <Geometry x:Key="MediaPauseGeometry">M4,2 H7 V14 H4 Z M10,2 H13 V14 H10 Z</Geometry>
  </Window.Resources>
  <Border x:Name="Outer" Margin="8,8,8,11">
    <Border x:Name="MainBorder" Background="{DynamicResource Brush.Island}" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1" CornerRadius="24">
      <Grid x:Name="IslandLayout">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid x:Name="Header" Grid.Row="0" Height="43" Background="Transparent" Cursor="Hand" PreviewMouseLeftButtonDown="Header_MouseDown" PreviewMouseMove="Header_MouseMove" PreviewMouseLeftButtonUp="Header_MouseUp">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid x:Name="DefaultHeaderLeft" VerticalAlignment="Center" Margin="14,0,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid x:Name="MascotArea" Width="48" Height="30">
              <Button x:Name="MascotButton" AutomationProperties.AutomationId="IslandExpandButton" Width="48" Height="30" Padding="0" Background="Transparent" BorderThickness="0" Focusable="False" IsHitTestVisible="False">
                <Button.Template><ControlTemplate TargetType="Button"><Image Source="pack://application:,,,/ChronoIsle;component/Assets/island-mascot.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="False"/></ControlTemplate></Button.Template>
              </Button>
              <Ellipse x:Name="StatusLight" Width="8" Height="8" IsHitTestVisible="False"
                       Fill="{DynamicResource Brush.Success}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0"/>
            </Grid>
            <Button x:Name="AgendaSummaryButton" Grid.Column="1"
                    AutomationProperties.AutomationId="IslandAgendaButton"
                    Style="{StaticResource CollapsedHeaderButton}" HorizontalContentAlignment="Stretch" IsHitTestVisible="False">
              <DockPanel x:Name="SummaryWidgets" LastChildFill="True" Margin="9,1,10,0" VerticalAlignment="Center">
                <TextBlock x:Name="MemoryUsageSummary" DockPanel.Dock="Right" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11"
                           Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="CpuUsageSummary" DockPanel.Dock="Right" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11"
                           Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="NetworkSpeedSummary" DockPanel.Dock="Right" Width="130" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11"
                           Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="Summary" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </DockPanel>
            </Button>
          </Grid>
          <StackPanel x:Name="ClockGroup" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,13,0">
            <Button x:Name="NetworkStatusLight" AutomationProperties.AutomationId="IslandNetworkStatusButton"
                    Style="{StaticResource CollapsedHeaderButton}" Margin="0,0,8,0"
                    VerticalAlignment="Center" IsHitTestVisible="False">
              <Viewbox Width="14" Height="14" Stretch="Uniform">
                <Path x:Name="NetworkStatusGlyph"
                      Data="{StaticResource Icon.NetworkGlobe}"
                      Stroke="{DynamicResource Brush.Success}" StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" Fill="Transparent"/>
              </Viewbox>
            </Button>
            <Button x:Name="ClockButton" AutomationProperties.AutomationId="IslandClockButton"
                    Style="{StaticResource CollapsedHeaderButton}" IsHitTestVisible="False">
              <TextBlock x:Name="Clock" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="15"
                         FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
            </Button>
            <TextBlock x:Name="ExpandIndicator" Text="›" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="20" VerticalAlignment="Center" RenderTransformOrigin=".5,.5"><TextBlock.RenderTransform><RotateTransform x:Name="ChevronRotate" Angle="0"/></TextBlock.RenderTransform></TextBlock>
          </StackPanel>
          <Grid x:Name="CollapsedMedia" Grid.ColumnSpan="2" Margin="10,0" Visibility="Collapsed" Panel.ZIndex="5">
            <Grid x:Name="CollapsedMediaTrack" Background="Transparent" MouseEnter="CollapsedMediaTrack_MouseEnter" MouseLeave="CollapsedMediaTrack_MouseLeave">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="104"/>
              </Grid.ColumnDefinitions>
              <Grid Width="32" Height="32" VerticalAlignment="Center">
                <Ellipse Fill="{DynamicResource Brush.Control}"/>
                <Image x:Name="CollapsedMediaArtwork" Width="32" Height="32" Stretch="UniformToFill"
                       RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True">
                  <Image.Clip><EllipseGeometry Center="16,16" RadiusX="16" RadiusY="16"/></Image.Clip>
                </Image>
                <TextBlock x:Name="CollapsedMediaArtworkPlaceholder" Text="♪" Foreground="{DynamicResource Brush.TextTertiary}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Grid>
              <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center">
                <TextBlock x:Name="CollapsedMediaTitle" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="CollapsedMediaArtist" Foreground="{DynamicResource Brush.TextTertiary}" FontSize="9" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
              </StackPanel>
              <Button x:Name="CollapsedMediaTrackButton" Grid.Column="2" Width="72" Height="34"
                      Style="{StaticResource CollapsedHeaderButton}" Background="Transparent"
                      Click="CollapsedMediaTrackButton_Click"

                      AutomationProperties.Name="实时音轨，悬浮显示播放控制">
                <Button.RenderTransform><TranslateTransform x:Name="CollapsedMediaTrackTranslate"/></Button.RenderTransform>
                <Border Width="70" Height="34" CornerRadius="15" Background="Transparent"
                        BorderThickness="0" SnapsToDevicePixels="False">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Height="34" Margin="0" UseLayoutRounding="False">
                    <Border x:Name="CollapsedSpectrum0" Width="4" Height="4" CornerRadius="2" Margin="2,0" Background="{DynamicResource Brush.Accent}" Opacity=".68" VerticalAlignment="Center" SnapsToDevicePixels="False"/>
                    <Border x:Name="CollapsedSpectrum1" Width="4" Height="4" CornerRadius="2" Margin="2,0" Background="{DynamicResource Brush.Accent}" Opacity=".84" VerticalAlignment="Center" SnapsToDevicePixels="False"/>
                    <Border x:Name="CollapsedSpectrum2" Width="4" Height="4" CornerRadius="2" Margin="2,0" Background="{DynamicResource Brush.Accent}" VerticalAlignment="Center" SnapsToDevicePixels="False"/>
                    <Border x:Name="CollapsedSpectrum3" Width="4" Height="4" CornerRadius="2" Margin="2,0" Background="{DynamicResource Brush.Accent}" Opacity=".84" VerticalAlignment="Center" SnapsToDevicePixels="False"/>
                    <Border x:Name="CollapsedSpectrum4" Width="4" Height="4" CornerRadius="2" Margin="2,0" Background="{DynamicResource Brush.Accent}" Opacity=".68" VerticalAlignment="Center" SnapsToDevicePixels="False"/>
                  </StackPanel>
                </Border>
              </Button>
              <StackPanel x:Name="CollapsedMediaControls" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
              <StackPanel.RenderTransform><TranslateTransform x:Name="CollapsedMediaControlsTranslate"/></StackPanel.RenderTransform>
              <Button x:Name="CollapsedMediaPrevious" Click="MediaPrevious_Click" Style="{StaticResource IslandIcon}" Width="28" Height="28" Padding="0">
                <Button.RenderTransform><TranslateTransform x:Name="CollapsedMediaPreviousTranslate"/></Button.RenderTransform>
                <Viewbox Width="12" Height="12">
                  <Path Data="{StaticResource MediaPreviousGeometry}" Fill="{DynamicResource Brush.TextPrimary}" Stretch="Uniform"/>
                </Viewbox>
              </Button>
              <Button x:Name="CollapsedMediaPlayPause" Click="MediaPlayPause_Click" Style="{StaticResource IslandIcon}" Width="30" Height="30" Padding="0" Margin="3,0">
                <Button.RenderTransform><TranslateTransform x:Name="CollapsedMediaPlayPauseTranslate"/></Button.RenderTransform>
                <Viewbox Width="12" Height="12">
                  <Grid Width="16" Height="16">
                    <Path x:Name="CollapsedMediaPlayIcon" Data="{StaticResource MediaPlayGeometry}" Fill="{DynamicResource Brush.TextPrimary}" Stretch="Uniform"/>
                    <Path x:Name="CollapsedMediaPauseIcon" Data="{StaticResource MediaPauseGeometry}" Fill="{DynamicResource Brush.TextPrimary}" Stretch="Uniform" Visibility="Collapsed"/>
                  </Grid>
                </Viewbox>
              </Button>
              <Button x:Name="CollapsedMediaNext" Click="MediaNext_Click" Style="{StaticResource IslandIcon}" Width="28" Height="28" Padding="0">
                <Button.RenderTransform><TranslateTransform x:Name="CollapsedMediaNextTranslate"/></Button.RenderTransform>
                <Viewbox Width="12" Height="12">
                  <Path Data="{StaticResource MediaNextGeometry}" Fill="{DynamicResource Brush.TextPrimary}" Stretch="Uniform"/>
                </Viewbox>
              </Button>
            </StackPanel>
            </Grid>
          </Grid>
          <Border x:Name="TopDockStatusLight" Height="6"
                  Background="{DynamicResource Brush.Island}"
                  CornerRadius="0,0,4,4"
                  HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                  Visibility="Collapsed" IsHitTestVisible="False"
                  Grid.ColumnSpan="2"
                  Panel.ZIndex="10">
            <Border x:Name="TopDockStatusPulse"
                    Background="{Binding Fill, ElementName=StatusLight}"
                    CornerRadius="0,0,4,4"
                    Opacity="1"/>
          </Border>
        </Grid>
        <ScrollViewer x:Name="ExpandedScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="0">
          <StackPanel x:Name="ExpandedContent" Visibility="Collapsed" MouseMove="ExpandedContent_MouseMove">
            <Border Height="1" Background="{DynamicResource Brush.Control}"/>
            <Border x:Name="ReminderBanner" Background="{DynamicResource Brush.AccentSoft}" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1" CornerRadius="12" Margin="12,12,12,0" Padding="12" Visibility="Collapsed">
              <DockPanel>
                <Button Content="×" Click="DismissReminderBanner_Click" Style="{StaticResource IslandIcon}" Padding="7,3" Margin="9,0,0,0" DockPanel.Dock="Right"/>
                <TextBlock x:Name="ReminderText" Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="Wrap" VerticalAlignment="Center"/>
              </DockPanel>
            </Border>
            <Grid x:Name="DashboardTabs" Margin="12,12,12,10">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="TodayDashboardTab" Content="今天" Click="TodayTab_Click" Style="{StaticResource IslandTab}"/>
                <Button x:Name="CalendarDashboardTab" Content="月历" Click="CalendarTab_Click" Style="{StaticResource IslandTab}" Background="{DynamicResource Brush.Hover}" BorderBrush="{DynamicResource Brush.TextTertiary}" Foreground="{DynamicResource Brush.TextPrimary}" Margin="7,0,0,0"/>
                <Button x:Name="StatusDashboardTab" Content="状态" Click="StatusTab_Click" Style="{StaticResource IslandTab}" Margin="7,0,0,0"/>
                <Button x:Name="QuickAskDashboardTab" Content="快问" Click="QuickAskTab_Click" Style="{StaticResource IslandTab}" Margin="7,0,0,0"/>
                <Button x:Name="ToolsDashboardTab" Content="工具" Click="ToolsTab_Click" Style="{StaticResource IslandTab}" Margin="7,0,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="IslandManagementButton" Content="☰ 事项管理"
                        Click="ManageItems_Click" Style="{StaticResource IslandTab}"
                        AutomationProperties.AutomationId="IslandManagementButton"
                        Margin="0,0,7,0"/>
                <Button x:Name="IslandSettingsButton" Content="⚙ 设置"
                        Click="Settings_Click" Style="{StaticResource IslandTab}"
                        AutomationProperties.AutomationId="IslandSettingsButton"/>
              </StackPanel>
            </Grid>
            <Border x:Name="CalendarPanel" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1" CornerRadius="14" Margin="12,0,12,12" Padding="14">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Button Grid.Column="0" Content="‹" Click="PreviousMonth_Click" Style="{StaticResource IslandIcon}"/>
                  <TextBlock x:Name="MonthTitle" Grid.Column="1" Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  <Button Grid.Column="2" Content="›" Click="NextMonth_Click" Style="{StaticResource IslandIcon}"/>
                </Grid>
                <UniformGrid Columns="7" Margin="0,12,0,4">
                  <TextBlock Text="一" Foreground="{DynamicResource Brush.TextTertiary}" HorizontalAlignment="Center"/><TextBlock Text="二" Foreground="{DynamicResource Brush.TextTertiary}" HorizontalAlignment="Center"/>
                  <TextBlock Text="三" Foreground="{DynamicResource Brush.TextTertiary}" HorizontalAlignment="Center"/><TextBlock Text="四" Foreground="{DynamicResource Brush.TextTertiary}" HorizontalAlignment="Center"/>
                  <TextBlock Text="五" Foreground="{DynamicResource Brush.TextTertiary}" HorizontalAlignment="Center"/><TextBlock Text="六" Foreground="{DynamicResource Brush.TextTertiary}" HorizontalAlignment="Center"/>
                  <TextBlock Text="日" Foreground="{DynamicResource Brush.TextTertiary}" HorizontalAlignment="Center"/>
                </UniformGrid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,7">
                  <TextBlock Text="休" Foreground="#FF6961" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="法定节假日" Foreground="{DynamicResource Brush.TextTertiary}" FontSize="10" Margin="3,0,10,0"/>
                  <TextBlock Text="班" Foreground="#FFB02E" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="调休上班" Foreground="{DynamicResource Brush.TextTertiary}" FontSize="10" Margin="3,0,0,0"/>
                </StackPanel>
                <UniformGrid x:Name="CalendarGrid" Columns="7"/>
                <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1" CornerRadius="10" Margin="0,12,0,9" Padding="12">
                  <StackPanel><TextBlock x:Name="SelectedDateTitle" Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold"/><StackPanel x:Name="DayAgendaList" Margin="0,8,0,0"/></StackPanel>
                </Border>
                <StackPanel>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="QuickAddDate" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                      <Button x:Name="ReminderTypeButton" Content="提醒" Click="ReminderType_Click" Style="{StaticResource IslandType}" Margin="0,0,6,0"/>
                      <Button x:Name="TodoTypeButton" Content="待办" Click="TodoType_Click" Style="{StaticResource IslandType}"/>
                    </StackPanel>
                  </Grid>
                  <DockPanel LastChildFill="True">
                    <Button Content="添加" Click="QuickAdd_Click" AutomationProperties.AutomationId="IslandQuickAddButton" Style="{StaticResource IslandPrimary}" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                    <ComboBox x:Name="HourSelector" Width="56" Height="34" Style="{StaticResource IslandSelect}" SelectionChanged="TimeSelector_SelectionChanged" DropDownOpened="TimeSelector_DropDownOpened" DropDownClosed="TimeSelector_DropDownClosed"/>
                    <TextBlock Text=":" Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" Margin="5,0"/>
                    <ComboBox x:Name="MinuteSelector" Width="56" Height="34" Style="{StaticResource IslandSelect}" SelectionChanged="TimeSelector_SelectionChanged" DropDownOpened="TimeSelector_DropDownOpened" DropDownClosed="TimeSelector_DropDownClosed"/>
                    <TextBox x:Name="QuickAddInput" AutomationProperties.AutomationId="IslandQuickAddInput" Height="34" Margin="8,0,0,0" TextChanged="QuickAddInput_TextChanged" Style="{StaticResource IslandTextInput}"/>
                  </DockPanel>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border x:Name="TelemetryPanel" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Stroke}"
                    BorderThickness="1" CornerRadius="14" Margin="12,0,12,12" Padding="16" Visibility="Collapsed">
              <StackPanel>
                <Grid Margin="0,0,0,14">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="TelemetryStatusLight" Width="8" Height="8" Fill="{DynamicResource Brush.Success}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TelemetryNetworkStatus" Text="正在读取网络状态" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="15" FontWeight="SemiBold"/>
                  </StackPanel>
                  <TextBlock x:Name="TelemetryLatency" Grid.Column="1" Text="-- ms" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11"/>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <Border Background="{DynamicResource Brush.Surface}" CornerRadius="12" Padding="14" Margin="0,0,6,0">
                    <StackPanel><TextBlock Text="上传" Foreground="{DynamicResource Brush.TextTertiary}" FontSize="10"/>
                      <TextBlock x:Name="TelemetryUploadSpeed" Text="0 B/s" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                  </Border>
                  <Border Grid.Column="1" Background="{DynamicResource Brush.Surface}" CornerRadius="12" Padding="14" Margin="6,0,0,0">
                    <StackPanel><TextBlock Text="下载" Foreground="{DynamicResource Brush.TextTertiary}" FontSize="10"/>
                      <TextBlock x:Name="TelemetryDownloadSpeed" Text="0 B/s" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="19" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                  </Border>
                </Grid>
                <Grid Margin="0,16,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="CPU" Foreground="{DynamicResource Brush.TextSecondary}"/>
                  <TextBlock x:Name="TelemetryCpuText" Grid.Column="1" Text="0%" Foreground="{DynamicResource Brush.TextPrimary}"/>
                </Grid>
                <ProgressBar x:Name="TelemetryCpuProgress" Height="5" Minimum="0" Maximum="100" Margin="0,6,0,0"
                             Foreground="{DynamicResource Brush.Accent}" Background="{DynamicResource Brush.Control}"/>
                <Grid Margin="0,13,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="内存" Foreground="{DynamicResource Brush.TextSecondary}"/>
                  <TextBlock x:Name="TelemetryMemoryText" Grid.Column="1" Text="0%" Foreground="{DynamicResource Brush.TextPrimary}"/>
                </Grid>
                <ProgressBar x:Name="TelemetryMemoryProgress" Height="5" Minimum="0" Maximum="100" Margin="0,6,0,0"
                             Foreground="{DynamicResource Brush.Accent}" Background="{DynamicResource Brush.Control}"/>
                <Grid Margin="0,16,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Text="今日流量" Foreground="{DynamicResource Brush.TextTertiary}" FontSize="10"/>
                    <TextBlock x:Name="TelemetryTodayTraffic" Text="0 B" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,4,0,0"/></StackPanel>
                  <StackPanel Grid.Column="1"><TextBlock Text="本月流量" Foreground="{DynamicResource Brush.TextTertiary}" FontSize="10"/>
                    <TextBlock x:Name="TelemetryMonthTraffic" Text="0 B" Foreground="{DynamicResource Brush.TextPrimary}" Margin="0,4,0,0"/></StackPanel>
                </Grid>
                <Border Height="1" Background="{DynamicResource Brush.StrokeSoft}" Margin="0,15,0,11"/>
                <TextBlock Text="最近 7 天" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" Margin="0,0,0,7"/>
                <StackPanel x:Name="TelemetryHistoryList"/>
              </StackPanel>
            </Border>
            <Border x:Name="QuickAskPanel" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1" CornerRadius="14" Margin="12,0,12,12" Padding="16" Visibility="Collapsed">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBlock Text="问一下 Island" Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold" FontSize="15"/>
                  <Button Grid.Column="1" Content="打开完整对话" Click="OpenFullChat_Click" Style="{StaticResource IslandIcon}" FontSize="11"/>
                </Grid>
                <TextBlock x:Name="QuickAskStatus" Text="准备就绪" Foreground="{DynamicResource Brush.TextTertiary}" FontSize="11" Margin="0,5,0,10"/>
                <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.StrokeSoft}" BorderThickness="1" CornerRadius="10" Padding="12" MinHeight="72" MaxHeight="180">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <local:MarkdownTextBlock x:Name="QuickAskAnswer" Markdown="输入一个问题，回答会在这里流式显示。" Foreground="{DynamicResource Brush.TextPrimary}"/>
                  </ScrollViewer>
                </Border>
                <TextBox x:Name="QuickAskInput" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="38" MaxHeight="82" Margin="0,12,0,8" Style="{StaticResource IslandTextInput}" TextChanged="QuickAskInput_TextChanged" KeyDown="QuickAskInput_KeyDown"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                  <Button x:Name="QuickAskStop" Content="停止" Click="QuickAskStop_Click" Style="{StaticResource IslandIcon}" Visibility="Collapsed" Margin="0,0,8,0"/>
                  <Button x:Name="QuickAskSend" Content="发送" Click="QuickAskSend_Click" Style="{StaticResource IslandPrimary}"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border x:Name="ToolsPanel" Background="{DynamicResource Brush.Card}"
                    BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1"
                    CornerRadius="14" Margin="12,0,12,12" Padding="16"
                    Visibility="Collapsed">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                  <Button x:Name="NamingToolTab" Content="取名"
                          Style="{StaticResource IslandTab}"
                          Background="{DynamicResource Brush.AccentSoft}"
                          BorderBrush="{DynamicResource Brush.Accent}" Margin="0,0,8,0"
                          Click="NamingToolTab_Click"/>
                  <Button x:Name="NetworkSpeedTestToolTab" Content="网络测速"
                          Style="{StaticResource IslandTab}"
                          Click="NetworkSpeedTestToolTab_Click"/>
                </StackPanel>
                <StackPanel x:Name="NamingToolPanel">
                  <Border Background="{DynamicResource Brush.Surface}"
                          BorderBrush="{DynamicResource Brush.StrokeSoft}"
                          BorderThickness="1" CornerRadius="10" Padding="14">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="取名助手" Foreground="{DynamicResource Brush.TextPrimary}"
                                   FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="为变量、方法、类型和数据库对象生成稳定命名。"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   FontSize="11" Margin="0,5,14,0" TextWrapping="Wrap"/>
                      </StackPanel>
                      <Button Grid.Column="1" Content="打开" Click="NamingTool_Click"
                              Style="{StaticResource IslandPrimary}"
                              AutomationProperties.AutomationId="IslandNamingButton"
                              VerticalAlignment="Center"/>
                    </Grid>
                  </Border>
                </StackPanel>
                <StackPanel x:Name="NetworkSpeedTestToolPanel" Visibility="Collapsed">
                  <Grid Height="154" Margin="0,0,0,12">
                    <Canvas Width="236" Height="154" HorizontalAlignment="Center">
                      <Path Data="M 20,122 A 98,98 0 0 1 216,122"
                            Stroke="{DynamicResource Brush.AccentSoft}" StrokeThickness="14"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                      <Path Data="M 20,122 A 98,98 0 0 1 216,122"
                            Stroke="{DynamicResource Brush.StrokeSoft}" StrokeThickness="1"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                      <Path Data="M 118,122 L 118,48" Stroke="{DynamicResource Brush.Accent}"
                            StrokeThickness="3" StrokeStartLineCap="Round">
                        <Path.RenderTransform>
                          <RotateTransform x:Name="NetworkSpeedTestGaugeNeedleRotation" CenterX="118" CenterY="122"/>
                        </Path.RenderTransform>
                      </Path>
                      <Ellipse Canvas.Left="112" Canvas.Top="116" Width="12" Height="12"
                               Fill="{DynamicResource Brush.Accent}"/>
                      <Path x:Name="NetworkSpeedTestSpinnerPath"
                            Data="M 20,122 A 98,98 0 0 1 216,122"
                            Stroke="{DynamicResource Brush.Accent}" StrokeThickness="3"
                            StrokeDashArray="2 5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                      <Path Stroke="{DynamicResource Brush.Accent}" StrokeThickness="5"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                        <Path.Data>
                          <PathGeometry>
                            <PathFigure StartPoint="20,122">
                              <ArcSegment x:Name="NetworkSpeedTestGaugeProgressArc" Point="20,122" Size="98,98"
                                          SweepDirection="Clockwise"/>
                            </PathFigure>
                          </PathGeometry>
                        </Path.Data>
                      </Path>
                      <StackPanel Canvas.Top="84" Width="236" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                          <TextBlock x:Name="NetworkSpeedTestGaugeValue" Text="--"
                                     Foreground="{DynamicResource Brush.TextPrimary}"
                                     FontSize="30" FontWeight="SemiBold"/>
                          <TextBlock x:Name="NetworkSpeedTestGaugeUnit" Text="Mbps"
                                     Foreground="{DynamicResource Brush.TextSecondary}"
                                     FontSize="11" Margin="6,15,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="NetworkSpeedTestPhaseText" Text="等待开始测速"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   FontSize="11" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        <Button x:Name="NetworkSpeedTestUnitButton" Content="Mbps ⇄ MB/s"
                                Style="{StaticResource IslandTab}" Click="NetworkSpeedTestUnitButton_Click"
                                MinHeight="20" Height="20" Padding="6,1" FontSize="10"
                                HorizontalAlignment="Center" Margin="0,2,0,0"/>
                      </StackPanel>
                    </Canvas>
                  </Grid>
                  <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.StrokeSoft}"
                            BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,0,4,0">
                      <StackPanel>
                        <TextBlock Text="下载" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="10"/>
                        <TextBlock x:Name="NetworkSpeedTestDownloadValue" Text="--"
                                   Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold" Margin="0,3,0,0"/>
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.StrokeSoft}"
                            BorderThickness="1" CornerRadius="10" Padding="8" Margin="2,0">
                      <StackPanel>
                        <TextBlock Text="上传" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="10"/>
                        <TextBlock x:Name="NetworkSpeedTestUploadValue" Text="--"
                                   Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold" Margin="0,3,0,0"/>
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.StrokeSoft}"
                            BorderThickness="1" CornerRadius="10" Padding="8" Margin="4,0,0,0">
                      <StackPanel>
                        <TextBlock Text="节点延迟" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="10"/>
                        <TextBlock x:Name="NetworkSpeedTestNodeLatencyValue" Text="--"
                                   Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold" Margin="0,3,0,0"/>
                      </StackPanel>
                    </Border>
                  </Grid>
                  <TextBlock Text="平台延迟" Foreground="{DynamicResource Brush.TextSecondary}"
                             FontSize="11" Margin="0,0,0,7"/>
                  <UniformGrid Columns="2" Margin="0,0,0,10">
                    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.StrokeSoft}"
                            BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,0,4,4">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Image Width="18" Height="18" Source="pack://application:,,,/ChronoIsle;component/Assets/platform-league.ico"
                               Stretch="Uniform" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="7,0,0,0">
                          <TextBlock Text="英雄联盟" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="10"/>
                          <TextBlock x:Name="NetworkSpeedTestLeagueLatency" Text="未测得" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="10" Margin="0,2,0,0"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.StrokeSoft}"
                            BorderThickness="1" CornerRadius="10" Padding="8" Margin="4,0,0,4">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Image Width="18" Height="18" Source="pack://application:,,,/ChronoIsle;component/Assets/platform-douyin.ico"
                               Stretch="Uniform" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="7,0,0,0">
                          <TextBlock Text="抖音" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="10"/>
                          <TextBlock x:Name="NetworkSpeedTestDouyinLatency" Text="未测得" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="10" Margin="0,2,0,0"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.StrokeSoft}"
                            BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,4,4,4">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Image Width="18" Height="18" Source="pack://application:,,,/ChronoIsle;component/Assets/platform-jd.ico"
                               Stretch="Uniform" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="7,0,0,0">
                          <TextBlock Text="京东" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="10"/>
                          <TextBlock x:Name="NetworkSpeedTestJdLatency" Text="未测得" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="10" Margin="0,2,0,0"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.StrokeSoft}"
                            BorderThickness="1" CornerRadius="10" Padding="8" Margin="4,4,0,4">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Image Width="18" Height="18" Source="pack://application:,,,/ChronoIsle;component/Assets/platform-ctrip.ico"
                               Stretch="Uniform" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="7,0,0,0">
                          <TextBlock Text="携程" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="10"/>
                          <TextBlock x:Name="NetworkSpeedTestCtripLatency" Text="未测得" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="10" Margin="0,2,0,0"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.StrokeSoft}"
                            BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,4,4,0">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Image Width="18" Height="18" Source="pack://application:,,,/ChronoIsle;component/Assets/platform-toutiao.ico"
                               Stretch="Uniform" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="7,0,0,0">
                          <TextBlock Text="今日头条" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="10"/>
                          <TextBlock x:Name="NetworkSpeedTestToutiaoLatency" Text="未测得" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="10" Margin="0,2,0,0"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </UniformGrid>
                  <Button x:Name="NetworkSpeedTestStartButton" Content="开始测速" Style="{StaticResource IslandNetworkSpeedTestPrimary}"
                          Click="NetworkSpeedTestStartButton_Click"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
  </Border>
</Window>
