                        <TextBlock Text="上传" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11"/>
                        <TextBlock x:Name="NetworkSpeedTestUploadValue" Text="--"
                                   Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold" Margin="0,3,0,0"/>
                      </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.StrokeSoft}"
                            BorderThickness="1" CornerRadius="10" Padding="8" Margin="4,0,0,0">
                      <StackPanel>
                        <TextBlock Text="节点延迟" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11"/>
                        <TextBlock x:Name="NetworkSpeedTestNodeLatencyValue" Text="--"
                                   Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold" Margin="0,3,0,0"/>
                      </StackPanel>
                    </Border>
                  </Grid>
                  <TextBlock Text="平台延迟" Foreground="{DynamicResource Brush.TextSecondary}"
                             FontSize="12" Margin="0,0,0,7"/>
                  <UniformGrid Columns="2" Margin="0,0,0,10">
                    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.StrokeSoft}"
                            BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,0,4,4">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Image Width="18" Height="18" Source="pack://application:,,,/ChronoIsle;component/Assets/platform-league.ico"
                               Stretch="Uniform" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="7,0,0,0">
                          <TextBlock Text="英雄联盟" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="11"/>
                          <TextBlock x:Name="NetworkSpeedTestLeagueLatency" Text="未测得" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.StrokeSoft}"
                            BorderThickness="1" CornerRadius="10" Padding="8" Margin="4,0,0,4">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Image Width="18" Height="18" Source="pack://application:,,,/ChronoIsle;component/Assets/platform-douyin.ico"
                               Stretch="Uniform" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="7,0,0,0">
                          <TextBlock Text="抖音" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="11"/>
                          <TextBlock x:Name="NetworkSpeedTestDouyinLatency" Text="未测得" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.StrokeSoft}"
                            BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,4,4,4">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Image Width="18" Height="18" Source="pack://application:,,,/ChronoIsle;component/Assets/platform-jd.ico"
                               Stretch="Uniform" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="7,0,0,0">
                          <TextBlock Text="京东" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="11"/>
                          <TextBlock x:Name="NetworkSpeedTestJdLatency" Text="未测得" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.StrokeSoft}"
                            BorderThickness="1" CornerRadius="10" Padding="8" Margin="4,4,0,4">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Image Width="18" Height="18" Source="pack://application:,,,/ChronoIsle;component/Assets/platform-ctrip.ico"
                               Stretch="Uniform" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="7,0,0,0">
                          <TextBlock Text="携程" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="11"/>
                          <TextBlock x:Name="NetworkSpeedTestCtripLatency" Text="未测得" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.StrokeSoft}"
                            BorderThickness="1" CornerRadius="10" Padding="8" Margin="0,4,4,0">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Image Width="18" Height="18" Source="pack://application:,,,/ChronoIsle;component/Assets/platform-toutiao.ico"
                               Stretch="Uniform" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="7,0,0,0">
                          <TextBlock Text="今日头条" Foreground="{DynamicResource Brush.TextPrimary}" FontSize="11"/>
                          <TextBlock x:Name="NetworkSpeedTestToutiaoLatency" Text="未测得" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="11" Margin="0,2,0,0"/>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </UniformGrid>
                  <Button x:Name="NetworkSpeedTestStartButton" Content="开始测速" Style="{StaticResource IslandNetworkSpeedTestPrimary}"
                          Click="NetworkSpeedTestStartButton_Click"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
    <!-- The static rim fades across a soft outer edge; neither layer contains text. -->
    <Border x:Name="IslandStaticRim" IsHitTestVisible="False" Visibility="Collapsed"
            BorderThickness="3" Margin="1" CornerRadius="{Binding CornerRadius, ElementName=MainBorder}"
            Opacity="{Binding Opacity, ElementName=MainBorder}" Clip="{Binding Clip, ElementName=MainBorder}"
            Style="{StaticResource Border.SmoothDecoration}"/>
    <!-- Cache only the outline at 2x; text stays on the native text-rendering path. -->
    <Border x:Name="IslandOutline" IsHitTestVisible="False" SnapsToDevicePixels="False" UseLayoutRounding="False"
            BorderBrush="{DynamicResource Brush.Stroke}"
            BorderThickness="{Binding BorderThickness, ElementName=MainBorder}"
            CornerRadius="{Binding CornerRadius, ElementName=MainBorder}"
            Opacity="{Binding Opacity, ElementName=MainBorder}"
            Clip="{Binding Clip, ElementName=MainBorder}"
            RenderOptions.BitmapScalingMode="HighQuality">
      <Border.CacheMode><BitmapCache RenderAtScale="2"/></Border.CacheMode>
    </Border>
  </Grid>
</Window>
