                <StackPanel x:Name="TelemetryHistoryList"/>
              </StackPanel>
            </Border>
            <Border RenderOptions.ClearTypeHint="Enabled" x:Name="QuickAskPanel" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.StrokeSoft}" BorderThickness="1" CornerRadius="14" Margin="12,0,12,12" Padding="16" Visibility="Collapsed">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
