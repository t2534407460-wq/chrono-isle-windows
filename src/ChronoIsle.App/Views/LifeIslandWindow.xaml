                                     Style="{StaticResource Text.Secondary}" Margin="0,5,0,10"/>
                          <TextBox x:Name="MeaningInput" Height="40" MaxLength="30"
                                   AcceptsReturn="False" TextWrapping="NoWrap"

  
                                   VerticalContentAlignment="Center" Padding="8,0"
                                   TextChanged="MeaningInput_TextChanged"
                                   AutomationProperties.AutomationId="NamingMeaningInput"/>
                          <TextBlock x:Name="MeaningInputCharCount" Text="0/30"
                                     FontSize="12" Foreground="{DynamicResource Brush.TextTertiary}"
                                     HorizontalAlignment="Right" Margin="0,4,0,0"/>

                          <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,14,0">
                              <TextBlock Text="名称类型" Style="{StaticResource Text.SectionTitle}"/>
                              <ComboBox x:Name="KindSelector" SelectedIndex="0" Margin="0,8,0,0"
