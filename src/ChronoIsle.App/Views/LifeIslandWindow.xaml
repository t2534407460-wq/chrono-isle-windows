                    Visibility="Collapsed">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                  <Button x:Name="NamingToolTab" Content="取名"
                          Style="{StaticResource IslandTab}"
                          Background="{DynamicResource Brush.AccentSoft}"
