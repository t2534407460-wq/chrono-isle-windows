<Window x:Class="ChronoIsle.App.Views.LifeMainWindow"
        Style="{StaticResource Window.Display}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:ChronoIsle.App"
        Title="时屿 ChronoIsle" Width="1120" Height="760" MinWidth="840" MinHeight="560"
        Background="Transparent" Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource Font.UI}" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize" AutomationProperties.AutomationId="LifeMainWindow">
  <WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="8" CornerRadius="16" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible"/>
    <Style x:Key="MessageItem" TargetType="ListBoxItem">
      <Setter Property="IsHitTestVisible" Value="False"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
      <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="FontSize" Value="13"/><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="12,8"/>
    </Style>
    <Style x:Key="SidebarFooterButton" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
      <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="13"/><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="12,8"/>
    </Style>
    <Style x:Key="ChatDeleteButton" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
      <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="#2B272E"/><Setter Property="Foreground" Value="#E5A2AA"/>
    </Style>
    <Style x:Key="WindowControl" TargetType="Button">
      <Setter Property="Width" Value="32"/><Setter Property="Height" Value="30"/><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="UseLayoutRounding" Value="True"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid Background="Transparent">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderThickness="0" CornerRadius="8" Style="{StaticResource Border.SmoothDecoration}"/>
        <Border BorderThickness="0" RenderOptions.ClearTypeHint="Enabled">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
      </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.Hover}"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Brush.Control}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="WindowCloseControl" TargetType="Button" BasedOn="{StaticResource WindowControl}">
      <Setter Property="Margin" Value="0"/><Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid Background="Transparent">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderThickness="0" CornerRadius="8" Style="{StaticResource Border.SmoothDecoration}"/>
        <Border BorderThickness="0" RenderOptions.ClearTypeHint="Enabled">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
      </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#5A2B32"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#71333D"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value=".4"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Border Background="{DynamicResource Brush.Window}" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1" CornerRadius="{StaticResource Radius.Window}" Style="{StaticResource Border.SmoothDecoration}"/>
  <Border RenderOptions.ClearTypeHint="Enabled" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource Radius.Window}" SnapsToDevicePixels="True">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0"><Image Source="pack://application:,,,/ChronoIsle;component/Assets/island-mascot.png" Width="54" Height="34" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="False"/><TextBlock Text="时屿 ChronoIsle" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
          <Button Click="Minimize_Click" Style="{StaticResource WindowControl}" ToolTip="最小化"><Viewbox Width="12" Height="12"><Path Data="M 1 6 L 11 6" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round"/></Viewbox></Button>
          <Button Click="Maximize_Click" Style="{StaticResource WindowControl}" ToolTip="最大化"><Viewbox Width="12" Height="12"><Path Data="M 2 2 L 10 2 L 10 10 L 2 10 Z" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" StrokeLineJoin="Round"/></Viewbox></Button>
          <Button Click="Close_Click" Style="{StaticResource WindowCloseControl}" ToolTip="关闭"><Viewbox Width="12" Height="12"><Path Data="M 2 2 L 10 10 M 10 2 L 2 10" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox></Button>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1" Margin="18,0,18,18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card.Standard}" Padding="12">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Button Grid.Row="0" Content="＋ 新对话" Command="{Binding NewChatCommand}" Style="{StaticResource Button.Primary}" Margin="0,0,0,12"/>
            <StackPanel Grid.Row="1">
              <Button Content="今天" Click="Today_Click" Style="{StaticResource NavButton}"/>
              <Button Content="日历" Click="Calendar_Click" Style="{StaticResource NavButton}"/>
              <Button Content="所有事项" Click="Manage_Click" Style="{StaticResource NavButton}"/>
            </StackPanel>
            <TextBlock Grid.Row="2" Text="最近对话" Style="{StaticResource Text.Tertiary}" Margin="12,18,0,6"/>
            <ListBox Grid.Row="3" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" MinWidth="0"><TextBlock Text="{Binding Title}" Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/></StackPanel>
                    <Button Grid.Column="1" Panel.ZIndex="1" Margin="6,0,0,0" Command="{Binding DataContext.DeleteChatCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource ChatDeleteButton}"><Viewbox Width="12" Height="12"><Path Data="M 2 2 L 10 10 M 10 2 L 2 10" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Viewbox></Button>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Button Grid.Row="4" Content="设置" Click="Settings_Click" Style="{StaticResource SidebarFooterButton}" Margin="0,10,0,0"/>
          </Grid>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card.Standard}" Padding="0">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="1"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="24,20,24,16">
              <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="对话" Style="{StaticResource Text.PageTitle}"/><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="11,2,0,0"><Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Success}" VerticalAlignment="Center"/><TextBlock Text="{Binding Status}" Style="{StaticResource Text.Tertiary}" Margin="5,0,0,0" VerticalAlignment="Center"/></StackPanel></StackPanel><TextBlock Text="用一句自然语言创建、安排和回顾你的事项" Style="{StaticResource Text.Secondary}" Margin="0,7,0,0"/></StackPanel>
            </Grid>
            <Border Grid.Row="1" Background="{DynamicResource Brush.StrokeSoft}"/>
            <ListBox Grid.Row="2" ItemsSource="{Binding Messages}" ItemContainerStyle="{StaticResource MessageItem}" Margin="24,20,24,12" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Border BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" Padding="16" Margin="0,0,0,14" MaxWidth="650">
                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource Brush.Card}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.StrokeSoft}"/><Setter Property="HorizontalAlignment" Value="Left"/><Style.Triggers><DataTrigger Binding="{Binding Role}" Value="user"><Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}"/><Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentSoft}"/><Setter Property="HorizontalAlignment" Value="Right"/></DataTrigger></Style.Triggers></Style></Border.Style>
                    <local:MarkdownTextBlock Markdown="{Binding Content}" FontSize="14" LineHeight="24" Foreground="{DynamicResource Brush.TextPrimary}"/>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Border Grid.Row="3" Style="{StaticResource Notice.Warning}" Padding="14" Margin="24,0,24,12" Visibility="{Binding HasPendingAction,Converter={StaticResource Visible}}" AutomationProperties.AutomationId="PendingActionCard">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="待确认计划" Style="{StaticResource Text.SectionTitle}"/><TextBlock Text="请核对全部步骤；确认后整体执行，失败时整体回滚。" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0"/><TextBlock Text="{Binding PendingActionText}" TextWrapping="Wrap" Margin="0,8,12,0" Foreground="{DynamicResource Brush.TextPrimary}"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0"><Button Content="取消全部" Command="{Binding CancelPendingActionCommand}" AutomationProperties.AutomationId="CancelPendingActionButton" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0"/><Button Content="确认全部" Command="{Binding ConfirmPendingActionCommand}" AutomationProperties.AutomationId="ConfirmPendingActionButton" Style="{StaticResource Button.Primary}"/></StackPanel>
              </Grid>
            </Border>
            <Border Grid.Row="4" Style="{StaticResource Card.Subtle}" Padding="6" Margin="24,0,24,22">
              <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0">
                  <Button Content="停止" Command="{Binding StopGeneratingCommand}" Visibility="{Binding IsSending,Converter={StaticResource Visible}}" Style="{StaticResource Button.Secondary}" Margin="0,0,8,0"/>
                  <Button Content="发送" Command="{Binding SendCommand}" AutomationProperties.AutomationId="ChatSendButton" Style="{StaticResource Button.Primary}"/>
                </StackPanel>
                <Grid><TextBox x:Name="ChatInputBox" AutomationProperties.AutomationId="ChatInput" Text="{Binding ChatInput,UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Style="{StaticResource TextBox.ChatComposer}" AcceptsReturn="True" TextWrapping="Wrap" TextChanged="ChatInput_TextChanged" SizeChanged="ChatInput_SizeChanged" ToolTip="输入你的问题，或使用 / 快速指令"/><TextBlock Text="例如：明早九点提醒我开会" IsHitTestVisible="False" Foreground="{DynamicResource Brush.TextTertiary}" VerticalAlignment="Center" Margin="8,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=ChatInputBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
              </DockPanel>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
  </Grid>
</Window>
