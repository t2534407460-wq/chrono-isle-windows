<Window x:Class="ChronoIsle.App.Views.IslandNotificationWindow"
        Style="{StaticResource Window.Display}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="388" SizeToContent="Height" Title="灵动岛通知"
        WindowStartupLocation="Manual" FontFamily="{StaticResource Font.UI}"
        Background="Transparent" AllowsTransparency="True"
        WindowStyle="None" ResizeMode="NoResize"
        ShowActivated="False" ShowInTaskbar="False" Topmost="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        MouseEnter="Notification_MouseEnter" MouseLeave="Notification_MouseLeave">
  <Window.Resources>
    <Style x:Key="NotificationAction" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
  </Window.Resources>
  <Grid>
    <Border Margin="8" CornerRadius="16" Background="{DynamicResource Brush.Island}" IsHitTestVisible="False">
      <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="3" Opacity=".22"/></Border.Effect>
    </Border>
  <Border x:Name="NotificationCard" Margin="8" Padding="16" RenderOptions.ClearTypeHint="Enabled"
          Background="{DynamicResource Brush.Island}"
          BorderBrush="{DynamicResource Brush.Stroke}"
          BorderThickness="1" CornerRadius="16">
    <Grid>
      <Grid.RenderTransform><TranslateTransform x:Name="NotificationTranslate"/></Grid.RenderTransform>
      <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Width="36" Height="36" VerticalAlignment="Top" CornerRadius="12"
              Background="{DynamicResource Brush.AccentSoft}">
        <Grid>
          <TextBlock x:Name="NotificationAppBadge" FontSize="15" FontWeight="SemiBold"
                     Foreground="{DynamicResource Brush.Accent}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <Image x:Name="NotificationAppIcon" Width="26" Height="26" Stretch="Uniform"
                 RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/>
        </Grid>
      </Border>
      <StackPanel Grid.Column="1" Margin="12,0,0,0">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="NotificationAppName" FontSize="12" FontWeight="SemiBold"
                     Foreground="{DynamicResource Brush.Accent}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
          <TextBlock x:Name="NotificationTime" Grid.Column="1" FontSize="11"
                     Foreground="{DynamicResource Brush.TextTertiary}"/>
        </Grid>
        <TextBlock x:Name="NotificationTitle" Margin="0,6,0,0" FontSize="14" FontWeight="SemiBold"
                   Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="Wrap"
                   TextTrimming="CharacterEllipsis" LineHeight="20" MaxHeight="40"/>
        <TextBlock x:Name="NotificationBody" Margin="0,4,0,0" FontSize="13" LineHeight="20" MaxHeight="60"
                   Foreground="{DynamicResource Brush.TextSecondary}"
                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Button x:Name="OpenAppButton" Content="打开应用 ↗" HorizontalAlignment="Left"
                  Style="{StaticResource NotificationAction}" Click="OpenApp_Click"
                  AutomationProperties.Name="打开通知来源应用"/>
          <Button Grid.Column="1" Content="清除" Style="{StaticResource NotificationAction}"
                  Click="Dismiss_Click" AutomationProperties.Name="清除此条通知"/>
        </Grid>
        <TextBlock x:Name="NotificationActionStatus" Visibility="Collapsed" FontSize="12" Margin="0,6,0,0"
                   TextWrapping="Wrap" Foreground="{DynamicResource Brush.Warning}"/>
      </StackPanel>
    </Grid>
  </Border>
  </Grid>
</Window>
