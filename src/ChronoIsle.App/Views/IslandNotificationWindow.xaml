<Window x:Class="ChronoIsle.App.Views.IslandNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="340" SizeToContent="Height"
        WindowStartupLocation="Manual"
        Background="Transparent" AllowsTransparency="True"
        WindowStyle="None" ResizeMode="NoResize"
        ShowActivated="False" ShowInTaskbar="False" Topmost="True"
        Focusable="False" UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Border x:Name="NotificationCard"
          Margin="6" Padding="12,10"
          Background="{DynamicResource Brush.Card}"
          BorderBrush="{DynamicResource Brush.Stroke}"
          BorderThickness="1" CornerRadius="17">
    <Border.Effect>
      <DropShadowEffect Color="#B0000000" BlurRadius="18" ShadowDepth="4" Opacity=".38"/>
    </Border.Effect>
    <Grid>
      <Grid.RenderTransform>
        <TranslateTransform x:Name="NotificationTranslate"/>
      </Grid.RenderTransform>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="32"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid Width="28" Height="28" VerticalAlignment="Top">
        <Border Background="{DynamicResource Brush.AccentSoft}"
                BorderBrush="{DynamicResource Brush.Accent}"
                BorderThickness="1" CornerRadius="9"/>
        <TextBlock x:Name="NotificationAppBadge" Text="•"
                   Foreground="{DynamicResource Brush.Accent}"
                   FontSize="11" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
      <StackPanel Grid.Column="1" Margin="9,0,0,0">
        <DockPanel LastChildFill="True">
          <Border DockPanel.Dock="Left"
                  Margin="0,0,8,0" Padding="6,2"
                  Background="{DynamicResource Brush.AccentSoft}"
                  CornerRadius="6">
            <TextBlock x:Name="NotificationAppName" Text="通知"
                       MaxWidth="72" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource Brush.Accent}"
                       FontSize="8.5" FontWeight="SemiBold"/>
          </Border>
          <TextBlock x:Name="NotificationTitle"
                     Foreground="{DynamicResource Brush.TextPrimary}"
                     FontSize="11.5" FontWeight="SemiBold"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <TextBlock x:Name="NotificationBody"
                   Margin="0,5,0,0"
                   Foreground="{DynamicResource Brush.TextSecondary}"
                   FontSize="9.5" LineHeight="14"
                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                   MaxHeight="28"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
