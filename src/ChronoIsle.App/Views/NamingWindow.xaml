<Window x:Class="ChronoIsle.App.Views.NamingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:domain="clr-namespace:ChronoIsle.App.Services.Domain"
        Title="取名助手" Width="720" Height="780" MinWidth="620" MinHeight="640"
        Background="Transparent" Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource Font.UI}" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize"
        AutomationProperties.AutomationId="NamingWindow">
  <WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="8"
                        CornerRadius="16" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible"/>
    <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}"/>
    <Style x:Key="TitleButton" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style x:Key="NavigationButton" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
      <Setter Property="Width" Value="38"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style x:Key="CopyButton" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
    </Style>
    <Style x:Key="ResultRow" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Brush.Card}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Stroke}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="Margin" Value="0,0,0,7"/>
    </Style>
  </Window.Resources>

  <Border Background="{DynamicResource Brush.Window}" BorderBrush="{DynamicResource Brush.Stroke}"
          BorderThickness="1" CornerRadius="{StaticResource Radius.Window}">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="44"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="18,0,10,0" MouseLeftButtonDown="TitleBar_MouseDown">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Path Data="M3,12 C3,7 7,3 12,3 C17,3 21,7 21,12 C21,17 17,21 12,21 C7,21 3,17 3,12 M8,12 L11,15 L16,9"
                Stroke="{DynamicResource Brush.Accent}" StrokeThickness="1.7"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                Width="18" Height="18" Stretch="Uniform" Margin="0,0,9,0"/>
          <TextBlock Text="取名助手" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"/>
        </StackPanel>
        <Button Grid.Column="1" Click="Close_Click" Style="{StaticResource TitleButton}"
                AutomationProperties.Name="关闭取名助手">
          <Path Data="M2,2 L10,10 M10,2 L2,10" Stroke="{DynamicResource Brush.TextSecondary}"
                StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                Width="12" Height="12" Stretch="Uniform"/>
        </Button>
      </Grid>

      <StackPanel Grid.Row="1" Margin="24,2,24,16">
        <TextBlock Text="为代码找到更合适的名字" Style="{StaticResource Text.PageTitle}"/>
        <TextBlock Text="描述中文含义并选择使用场景。语义交给 AI，所有命名格式都在本地稳定生成。"
                   Style="{StaticResource Text.Secondary}" Margin="0,6,0,0" TextWrapping="Wrap"/>
      </StackPanel>

      <ScrollViewer x:Name="ContentScroller" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled" Margin="24,0,14,22">
        <StackPanel Margin="0,0,10,0">
          <Border Style="{StaticResource Card.Standard}" Padding="18" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="中文含义" Style="{StaticResource Text.SectionTitle}"/>
              <TextBlock Text="可以是一句话，例如“当前登录用户的最后活跃时间”。"
                         Style="{StaticResource Text.Secondary}" Margin="0,5,0,10"/>
              <TextBox x:Name="MeaningInput" Height="96" MaxLength="500"
                       AcceptsReturn="True" TextWrapping="Wrap"
                       VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                       AutomationProperties.AutomationId="NamingMeaningInput"/>

              <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,14,0">
                  <TextBlock Text="名称类型" Style="{StaticResource Text.SectionTitle}"/>
                  <ComboBox x:Name="KindSelector" SelectedIndex="0" Margin="0,8,0,0"
                            AutomationProperties.AutomationId="NamingKindSelector">
                    <ComboBoxItem Content="变量" Tag="{x:Static domain:NamingKind.Variable}"/>
                    <ComboBoxItem Content="函数 / 方法" Tag="{x:Static domain:NamingKind.Function}"/>
                    <ComboBoxItem Content="类 / 接口" Tag="{x:Static domain:NamingKind.Type}"/>
                    <ComboBoxItem Content="数据库表" Tag="{x:Static domain:NamingKind.DatabaseTable}"/>
                    <ComboBoxItem Content="数据库字段 / 列" Tag="{x:Static domain:NamingKind.DatabaseColumn}"/>
                    <ComboBoxItem Content="文件 / 目录" Tag="{x:Static domain:NamingKind.FileOrDirectory}"/>
                    <ComboBoxItem Content="常量" Tag="{x:Static domain:NamingKind.Constant}"/>
                    <ComboBoxItem Content="角色 / 通用名称" Tag="{x:Static domain:NamingKind.CharacterOrGeneral}"/>
                  </ComboBox>
                </StackPanel>
                <Button x:Name="GenerateButton" Grid.Column="1" Content="生成命名"
                        Click="Generate_Click" Style="{StaticResource Button.Primary}"
                        VerticalAlignment="Bottom" MinWidth="112"
                        AutomationProperties.AutomationId="NamingGenerateButton"/>
              </Grid>

              <StackPanel x:Name="LoadingPanel" Orientation="Horizontal" Visibility="Collapsed"
                          Margin="0,14,0,0" AutomationProperties.AutomationId="NamingLoadingState">
                <Path Data="M12,2 A10,10 0 1 1 4.9,4.9" Stroke="{DynamicResource Brush.Accent}"
                      StrokeThickness="2" StrokeStartLineCap="Round" Width="18" Height="18"
                      Stretch="Uniform" RenderTransformOrigin=".5,.5">
                  <Path.RenderTransform>
                    <RotateTransform x:Name="LoadingRotation"/>
                  </Path.RenderTransform>
                </Path>
                <TextBlock Text="正在理解语义并生成候选…" Foreground="{DynamicResource Brush.TextSecondary}"
                           VerticalAlignment="Center" Margin="9,0,0,0"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border x:Name="StatusNotice" Style="{StaticResource Notice.Error}"
                  Visibility="Collapsed" Padding="13" Margin="0,0,0,14"
                  AutomationProperties.AutomationId="NamingStatusNotice">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Path x:Name="StatusIcon" Data="M12,3 L22,21 L2,21 Z M12,9 L12,14 M12,17 L12,18"
                    Stroke="{DynamicResource Brush.Danger}" StrokeThickness="1.7"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                    Width="18" Height="18" Stretch="Uniform" Margin="0,0,10,0"/>
              <TextBlock x:Name="StatusText" Grid.Column="1" TextWrapping="Wrap"
                         VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}"/>
            </Grid>
          </Border>

          <Border x:Name="EmptyState" Style="{StaticResource Card.Subtle}" Padding="30"
                  AutomationProperties.AutomationId="NamingEmptyState">
            <StackPanel HorizontalAlignment="Center">
              <Path Data="M12,2 L14.2,8.8 L21,11 L14.2,13.2 L12,20 L9.8,13.2 L3,11 L9.8,8.8 Z"
                    Fill="{DynamicResource Brush.Accent}" Width="28" Height="28"
                    Stretch="Uniform" HorizontalAlignment="Center"/>
              <TextBlock Text="准备好后生成第一组名字" FontSize="15" FontWeight="SemiBold"
                         HorizontalAlignment="Center" Margin="0,13,0,0"/>
              <TextBlock Text="系统会给出三个候选，并为每个候选生成八种固定格式。"
                         Style="{StaticResource Text.Secondary}" TextAlignment="Center"
                         HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>

          <Border x:Name="ResultCard" Style="{StaticResource Card.Standard}" Padding="18"
                  Visibility="Collapsed" AutomationProperties.AutomationId="NamingResultCard">
            <StackPanel>
              <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,14,0">
                  <TextBlock x:Name="CandidatePhrase" FontSize="21" FontWeight="SemiBold"
                             Foreground="{DynamicResource Brush.TextPrimary}"/>
                  <TextBlock x:Name="CandidateDescription" Style="{StaticResource Text.Secondary}"
                             Margin="0,5,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button x:Name="PreviousButton" Click="Previous_Click"
                          Style="{StaticResource NavigationButton}"
                          AutomationProperties.AutomationId="NamingPreviousButton"
                          AutomationProperties.Name="上一个候选">
                    <Path Data="M8,2 L2,8 L8,14" Stroke="{DynamicResource Brush.TextPrimary}"
                          StrokeThickness="1.8" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="9" Height="15" Stretch="Uniform"/>
                  </Button>
                  <Border Background="{DynamicResource Brush.Surface}" CornerRadius="{StaticResource Radius.Button}"
                          Padding="11,7" Margin="7,0">
                    <TextBlock x:Name="CandidateCounter" FontSize="12"
                               Foreground="{DynamicResource Brush.TextSecondary}" MinWidth="28"
                               TextAlignment="Center"/>
                  </Border>
                  <Button x:Name="NextButton" Click="Next_Click"
                          Style="{StaticResource NavigationButton}"
                          AutomationProperties.AutomationId="NamingNextButton"
                          AutomationProperties.Name="下一个候选">
                    <Path Data="M2,2 L8,8 L2,14" Stroke="{DynamicResource Brush.TextPrimary}"
                          StrokeThickness="1.8" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="9" Height="15" Stretch="Uniform"/>
                  </Button>
                </StackPanel>
              </Grid>

              <Border x:Name="RecommendedNameCard" Background="{DynamicResource Brush.AccentSoft}" BorderBrush="{DynamicResource Brush.Accent}"
                      BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" Padding="14,11"
                      Margin="0,0,0,12" AutomationProperties.AutomationId="NamingRecommendedCard">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Border Background="{DynamicResource Brush.Accent}" CornerRadius="{StaticResource Radius.Pill}"/>
                  <StackPanel Grid.Column="1" Margin="12,0,14,0">
                    <StackPanel Orientation="Horizontal">
                      <Path Data="M7,1 L9,5 L13,5 L10,8 L11,13 L7,10 L3,13 L4,8 L1,5 L5,5 Z"
                            Fill="{DynamicResource Brush.Accent}" Width="13" Height="13" Stretch="Uniform" Margin="0,1,6,0"/>
                      <TextBlock x:Name="RecommendedNameLabel" FontSize="12" FontWeight="SemiBold"
                                 Foreground="{DynamicResource Brush.TextPrimary}"/>
                    </StackPanel>
                    <TextBlock x:Name="RecommendedNameValue" FontFamily="Cascadia Mono, Consolas"
                               FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}"
                               TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                    <TextBlock x:Name="RecommendedHint" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}"
                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                  </StackPanel>
                  <Button Grid.Column="2" Click="CopyRecommended_Click" Style="{StaticResource Button.Secondary}"
                          Padding="12,7" VerticalAlignment="Center"
                          AutomationProperties.AutomationId="NamingCopyRecommendedButton"
                          AutomationProperties.Name="复制建议命名">
                    <StackPanel Orientation="Horizontal">
                      <Path Data="M4,1 L12,1 L12,9 M2,4 L9,4 L9,12 L2,12 Z"
                            Stroke="{DynamicResource Brush.TextPrimary}" StrokeThickness="1.4"
                            StrokeLineJoin="Round" Width="13" Height="13" Stretch="Uniform"/>
                      <TextBlock Text="复制建议" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </Grid>
              </Border>

              <ItemsControl x:Name="FormatRows" AutomationProperties.AutomationId="NamingFormatRows">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource ResultRow}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="112"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Brush.TextSecondary}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="Cascadia Mono, Consolas"
                                   FontSize="13" Foreground="{DynamicResource Brush.TextPrimary}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0,10,0"/>
                        <Button Grid.Column="2" Click="Copy_Click" Style="{StaticResource CopyButton}"
                                AutomationProperties.AutomationId="{Binding AutomationId}"
                                AutomationProperties.Name="{Binding CopyAccessibleName}">
                          <StackPanel Orientation="Horizontal">
                            <Path Data="M4,1 L12,1 L12,9 M2,4 L9,4 L9,12 L2,12 Z"
                                  Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.4"
                                  StrokeLineJoin="Round" Width="13" Height="13" Stretch="Uniform"/>
                            <TextBlock Text="复制" Margin="6,0,0,0" VerticalAlignment="Center"/>
                          </StackPanel>
                        </Button>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</Window>
