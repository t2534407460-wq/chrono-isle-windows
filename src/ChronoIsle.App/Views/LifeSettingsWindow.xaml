<Window x:Class="ChronoIsle.App.Views.LifeSettingsWindow"
        Style="{StaticResource Window.Display}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="时屿设置" Width="720" Height="720" MinWidth="560" MinHeight="520"
        Background="Transparent" Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="{StaticResource Font.UI}" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize"
        Closing="LifeSettingsWindow_Closing">
  <WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="8" CornerRadius="16" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
  <Window.Resources>
    <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}"/>
    <Style x:Key="DialogTitleButton" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
      <Setter Property="Width" Value="34"/><Setter Property="Height" Value="30"/><Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="18"/>
    </Style>
    <Style x:Key="IslandVisualOption" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="Padding" Value="7,5"/>
      <Setter Property="Margin" Value="3"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid Background="Transparent">
          <Border x:Name="OptionSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                  CornerRadius="10" Style="{StaticResource Border.SmoothDecoration}"/>
          <Grid x:Name="OptionFocus" Visibility="Collapsed" IsHitTestVisible="False">
            <Border BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="3" CornerRadius="9" Margin="1" Opacity=".10"
                    Style="{StaticResource Border.SmoothDecoration}"/>
            <Border BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1.5" CornerRadius="10" Opacity=".8"
                    Style="{StaticResource Border.SmoothDecoration}">
              <Border.CacheMode><BitmapCache RenderAtScale="4"/></Border.CacheMode>
              <Border.OpacityMask>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                  <GradientStop Color="#B3000000" Offset="0"/>
                  <GradientStop Color="#40000000" Offset=".55"/>
                  <GradientStop Color="#80000000" Offset="1"/>
                </LinearGradientBrush>
              </Border.OpacityMask>
            </Border>
          </Grid>
          <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <Border x:Name="SelectionIndicator" Width="12" Height="2" CornerRadius="1" Margin="0,0,0,2"
                  VerticalAlignment="Bottom" Background="{DynamicResource Brush.Accent}" Visibility="Collapsed"
                  Style="{StaticResource Border.SmoothDecoration}"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True">
            <Setter TargetName="OptionSurface" Property="Background" Value="{DynamicResource Brush.Control}"/>
            <Setter TargetName="OptionSurface" Property="BorderBrush" Value="{DynamicResource Brush.StrokeSoft}"/>
            <Setter TargetName="SelectionIndicator" Property="Visibility" Value="Visible"/>
          </Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="OptionSurface" Property="Background" Value="{DynamicResource Brush.Hover}"/></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="OptionFocus" Property="Visibility" Value="Visible"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Border Background="{DynamicResource Brush.Window}" BorderBrush="{DynamicResource Brush.Stroke}" BorderThickness="1" CornerRadius="{StaticResource Radius.Window}" Style="{StaticResource Border.SmoothDecoration}"/>
  <Border RenderOptions.ClearTypeHint="Enabled" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="{StaticResource Radius.Window}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="18,0,10,0" MouseLeftButtonDown="TitleBar_MouseDown">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="设置" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14"/>
        <Button Grid.Column="1" Content="×" Click="Close_Click" Style="{StaticResource DialogTitleButton}" ToolTip="关闭"/>
      </Grid>
      <Grid Grid.Row="1" Margin="24,0,24,22">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="设置" Style="{StaticResource Text.PageTitle}"/>
            <TextBlock Text="管理本地助手、提醒和数据。所有设置仅保存在此设备。" Style="{StaticResource Text.Secondary}" Margin="0,6,0,20"/>
            <Border Style="{StaticResource Card.Standard}" Padding="18" Margin="0,0,0,14"><StackPanel>
              <TextBlock Text="AI 模型" Style="{StaticResource Text.SectionTitle}"/><TextBlock Text="DeepSeek 为默认预设，也兼容 OpenAI 格式服务。" Style="{StaticResource Text.Secondary}" Margin="0,5,0,16"/>
              <TextBlock Text="Base URL" Style="{StaticResource Text.Secondary}"/><TextBox x:Name="Url" Margin="0,5,0,12"/>
              <TextBlock Text="模型" Style="{StaticResource Text.Secondary}"/><TextBox x:Name="Model" Margin="0,5,0,12"/>
              <TextBlock Text="API Key" Style="{StaticResource Text.Secondary}"/><PasswordBox x:Name="Key" Margin="0,5,0,12"/>
              <StackPanel Orientation="Horizontal"><Button Content="测试连接" Click="Test_Click"/><TextBlock x:Name="Result" Foreground="{DynamicResource Brush.Success}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/></StackPanel>
            </StackPanel></Border>
            <Border Style="{StaticResource Card.Standard}" Padding="18" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel>
              <TextBlock Text="通知与启动" Style="{StaticResource Text.SectionTitle}"/>
              <TextBlock Text="Windows 通知" FontSize="14" Margin="0,14,0,2"/><TextBlock Text="待办与日程到期时发送系统通知，并同步在灵动岛中提示。" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"/>
              <TextBlock Text="开机自启" FontSize="14" Margin="0,14,0,2"/><TextBlock x:Name="AutoStartStatus" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"/>
            </StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><CheckBox x:Name="WindowsNotifications" Margin="0,0,0,20"/><CheckBox x:Name="AutoStart" Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"/></StackPanel></Grid></Border>
            <Border Style="{StaticResource Card.Standard}" Padding="18" Margin="0,0,0,14">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,14,0">
                    <TextBlock Text="Windows 通知" Style="{StaticResource Text.SectionTitle}"/>
                    <TextBlock Text="由灵动岛显示应用通知，替换系统横幅。" Style="{StaticResource Text.Secondary}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                  <CheckBox x:Name="ToastInboxEnabled" Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="用灵动岛替换 Windows 通知横幅"/>
                </Grid>
                <TextBlock Text="通知仍保留在 Windows 通知中心；关闭此项或退出时恢复原横幅设置。" Style="{StaticResource Text.Secondary}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="ToastInboxStatus" Style="{StaticResource Text.Secondary}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <Button x:Name="RetryToastAccessButton" Content="重新连接" Click="RetryToastAccess_Click" Padding="10,5"/>
                  <Button Content="通知访问权限" Click="ToastAccessSettings_Click" Padding="10,5" Margin="8,0,0,0"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card.Standard}" Padding="18" Margin="0,0,0,14"><StackPanel>
              <TextBlock Text="灵动岛、媒体与系统" Style="{StaticResource Text.SectionTitle}"/>
              <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="主题"/><TextBlock Text="可跟随 Windows，也可固定深色或浅色。" Style="{StaticResource Text.Secondary}" Margin="0,3,12,0"/></StackPanel>
                <ComboBox x:Name="ThemeModeSelector" Grid.Column="1" SelectedValuePath="Tag" SelectionChanged="ThemeSelection_Changed">
                  <ComboBoxItem Tag="System" Content="跟随 Windows"/><ComboBoxItem Tag="Dark" Content="深色"/><ComboBoxItem Tag="Light" Content="浅色"/>
                </ComboBox>
              </Grid>
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="强调色"/><TextBlock Text="选择后立即预览，保存后生效。" Style="{StaticResource Text.Secondary}" Margin="0,3,12,0"/></StackPanel>
                <ComboBox x:Name="AccentSchemeSelector" Grid.Column="1" SelectedValuePath="Tag" SelectionChanged="ThemeSelection_Changed">
                  <ComboBoxItem Tag="Emerald"><StackPanel Orientation="Horizontal"><Ellipse Width="10" Height="10" Fill="#39C98B" Margin="0,0,8,0"/><TextBlock Text="翠绿"/></StackPanel></ComboBoxItem>
                  <ComboBoxItem Tag="OceanBlue"><StackPanel Orientation="Horizontal"><Ellipse Width="10" Height="10" Fill="#58A6FF" Margin="0,0,8,0"/><TextBlock Text="海蓝"/></StackPanel></ComboBoxItem>
                  <ComboBoxItem Tag="Violet"><StackPanel Orientation="Horizontal"><Ellipse Width="10" Height="10" Fill="#B39DFF" Margin="0,0,8,0"/><TextBlock Text="紫罗兰"/></StackPanel></ComboBoxItem>
                  <ComboBoxItem Tag="Amber"><StackPanel Orientation="Horizontal"><Ellipse Width="10" Height="10" Fill="#F0B44C" Margin="0,0,8,0"/><TextBlock Text="琥珀"/></StackPanel></ComboBoxItem>
                  <ComboBoxItem Tag="Rose"><StackPanel Orientation="Horizontal"><Ellipse Width="10" Height="10" Fill="#F07FA2" Margin="0,0,8,0"/><TextBlock Text="玫红"/></StackPanel></ComboBoxItem>
                  <ComboBoxItem Tag="Cyan"><StackPanel Orientation="Horizontal"><Ellipse Width="10" Height="10" Fill="#4DD4D0" Margin="0,0,8,0"/><TextBlock Text="青色"/></StackPanel></ComboBoxItem>
                  <ComboBoxItem Tag="OrangeRed"><StackPanel Orientation="Horizontal"><Ellipse Width="10" Height="10" Fill="#FF8266" Margin="0,0,8,0"/><TextBlock Text="橙红"/></StackPanel></ComboBoxItem>
                  <ComboBoxItem Tag="Black"><StackPanel Orientation="Horizontal"><Ellipse Width="10" Height="10" Fill="#202326" Stroke="#737A76" StrokeThickness="1" Margin="0,0,8,0"/><TextBlock Text="黑"/></StackPanel></ComboBoxItem>
                  <ComboBoxItem Tag="White"><StackPanel Orientation="Horizontal"><Ellipse Width="10" Height="10" Fill="#F5F7F6" Stroke="#737A76" StrokeThickness="1" Margin="0,0,8,0"/><TextBlock Text="白"/></StackPanel></ComboBoxItem>
                </ComboBox>
              </Grid>
              <Border Background="{DynamicResource Brush.Surface}" CornerRadius="12" Padding="12" Margin="0,14,0,0">
                <StackPanel>
                  <TextBlock Text="折叠态显示" FontWeight="SemiBold"/>
                  <TextBlock Text="选择灵动岛收起时保留的信息与控件。" Style="{StaticResource Text.Secondary}" Margin="0,3,0,9"/>
                  <Border x:Name="CollapsedIslandOptions"
                          Background="{DynamicResource Brush.Island}"
                          BorderBrush="{DynamicResource Brush.Stroke}"
                          BorderThickness="1" CornerRadius="24" Padding="8">
                    <WrapPanel>
                        <CheckBox x:Name="IslandShowMascot"
                                  Style="{StaticResource IslandVisualOption}"
                                  ToolTip="吉祥物" AutomationProperties.Name="吉祥物">
                          <Image Source="pack://application:,,,/ChronoIsle;component/Assets/island-mascot.png"
                                 Width="48" Height="30" Stretch="Uniform"
                                 RenderOptions.BitmapScalingMode="HighQuality"/>
                        </CheckBox>
                        <CheckBox x:Name="IslandShowStatusLight"
                                  Style="{StaticResource IslandVisualOption}"
                                  ToolTip="事项状态点" AutomationProperties.Name="事项状态点">
                          <Grid Width="16" Height="30">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource Brush.Success}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Grid>
                        </CheckBox>
                        <CheckBox x:Name="IslandShowAgendaSummary"
                                  Style="{StaticResource IslandVisualOption}"
                                  ToolTip="事项与状态摘要" AutomationProperties.Name="事项与状态摘要">
                          <TextBlock Text="今天暂无安排"
                                     Foreground="{DynamicResource Brush.TextSecondary}"
                                     FontSize="12" Width="96"
                                     VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis"/>
                        </CheckBox>
                        <CheckBox x:Name="IslandShowNetworkSpeed"
                                  Style="{StaticResource IslandVisualOption}"
                                  ToolTip="实时网速" AutomationProperties.Name="实时网速">
                          <TextBlock Text="↑ 1.2 KB/s  ↓ 3.6 KB/s"
                                     Foreground="{DynamicResource Brush.TextSecondary}"
                                     FontSize="12" VerticalAlignment="Center"/>
                        </CheckBox>
                        <CheckBox x:Name="IslandShowCpuUsage"
                                  Style="{StaticResource IslandVisualOption}"
                                  ToolTip="CPU 占用" AutomationProperties.Name="CPU 占用">
                          <TextBlock Text="CPU 19%"
                                     Foreground="{DynamicResource Brush.TextSecondary}"
                                     FontSize="12" VerticalAlignment="Center"/>
                        </CheckBox>
                        <CheckBox x:Name="IslandShowMemoryUsage"
                                  Style="{StaticResource IslandVisualOption}"
                                  ToolTip="内存占用" AutomationProperties.Name="内存占用">
                          <TextBlock Text="内存 61%"
                                     Foreground="{DynamicResource Brush.TextSecondary}"
                                     FontSize="12" VerticalAlignment="Center"/>
                        </CheckBox>
                        <CheckBox x:Name="IslandShowFps"
                                  Style="{StaticResource IslandVisualOption}"
                                  ToolTip="当前前台应用帧率" AutomationProperties.Name="FPS 帧率">
                          <TextBlock Text="FPS 60"
                                     Foreground="{DynamicResource Brush.TextSecondary}"
                                     FontSize="12" VerticalAlignment="Center"/>
                        </CheckBox>
                        <CheckBox x:Name="IslandShowNetworkStatus"
                                  Style="{StaticResource IslandVisualOption}"
                                  ToolTip="网络状态点" AutomationProperties.Name="网络状态点">
                          <Viewbox Width="14" Height="14" Stretch="Uniform">
                            <Path x:Name="SettingsNetworkStatusGlyph"
                                  Data="{StaticResource Icon.NetworkGlobe}"
                                  Stroke="{DynamicResource Brush.Success}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Fill="Transparent"/>
                          </Viewbox>
                        </CheckBox>
                        <CheckBox x:Name="IslandShowNetworkLatency"
                                  Style="{StaticResource IslandVisualOption}"
                                  ToolTip="网络延迟" AutomationProperties.Name="网络延迟">
                          <TextBlock Text="20 ms"
                                     Foreground="{DynamicResource Brush.TextSecondary}"
                                     FontSize="12" VerticalAlignment="Center"/>
                        </CheckBox>
                        <CheckBox x:Name="IslandShowClock"
                                  Style="{StaticResource IslandVisualOption}"
                                  ToolTip="时间" AutomationProperties.Name="时间">
                          <TextBlock Text="12:34:56"
                                     Foreground="{DynamicResource Brush.TextPrimary}"
                                     FontFamily="{StaticResource Font.Clock}" FontSize="15" FontWeight="Bold" Typography.NumeralAlignment="Tabular"
                                     VerticalAlignment="Center"/>
                        </CheckBox>
                        <CheckBox x:Name="IslandShowExpandIndicator"
                                  Style="{StaticResource IslandVisualOption}"
                                  ToolTip="展开箭头" AutomationProperties.Name="展开箭头">
                          <TextBlock Text="›"
                                     Foreground="{DynamicResource Brush.TextSecondary}"
                                     FontSize="20" VerticalAlignment="Center"/>
                        </CheckBox>
                    </WrapPanel>
                  </Border>
                </StackPanel>
              </Border>
              <CheckBox x:Name="TelemetryEnabled" Content="显示实时网速、流量、CPU 与内存" Margin="0,14,0,0"/>
              <CheckBox x:Name="GlowBorderEnabled" Content="启用低饱和青绿流光边框与弹簧动画" Margin="0,12,0,0"/>
              <CheckBox x:Name="MediaAutoTakeover" Content="播放音乐时在折叠岛显示歌曲信息" Margin="0,14,0,0"/>
              <CheckBox x:Name="MoveIslandDuringFullscreen" Content="游戏全屏时将灵动岛移至其他屏幕" Margin="0,12,0,0"/>
              <TextBlock Text="全屏结束后会恢复原位置；没有其他屏幕时才临时隐藏。" Style="{StaticResource Text.Secondary}" Margin="24,3,0,12" TextWrapping="Wrap"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card.Standard}" Padding="18" Margin="0,0,0,14"><StackPanel>
              <TextBlock Text="本地数据" Style="{StaticResource Text.SectionTitle}"/>
              <TextBlock Text="便携备份不会携带外部账户令牌；在新设备恢复后需重新登录。ICS 导入会保存为本地副本。" Style="{StaticResource Text.Secondary}" Margin="0,5,0,12" TextWrapping="Wrap"/>
              <WrapPanel><Button Content="创建备份" Click="CreateBackup_Click" Margin="0,0,8,8"/><Button Content="恢复备份" Click="RestoreBackup_Click" Margin="0,0,8,8"/><Button Content="导出 ICS" Click="ExportIcs_Click" Margin="0,0,8,8"/><Button Content="导入 ICS" Click="ImportIcs_Click" Margin="0,0,8,8"/></WrapPanel>
              <TextBlock x:Name="DataResult" Foreground="{DynamicResource Brush.Success}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel></Border>
            <Border Style="{StaticResource Card.Standard}" Padding="18" Margin="0,0,0,14"><StackPanel>
              <TextBlock Text="助手人格" Style="{StaticResource Text.SectionTitle}"/>
              <TextBlock Text="人格只改变聊天措辞，不会改变确认、权限、排序或实际执行。" Style="{StaticResource Text.Secondary}" Margin="0,5,0,10" TextWrapping="Wrap"/>
              <ComboBox x:Name="Persona" SelectedValuePath="Tag" Width="160" HorizontalAlignment="Left"><ComboBoxItem Tag="Direct" Content="干练型"/><ComboBoxItem Tag="Gentle" Content="温柔型"/><ComboBoxItem Tag="Witty" Content="轻松型"/><ComboBoxItem Tag="Focused" Content="专注型"/></ComboBox>
            </StackPanel></Border>
            <Border Style="{StaticResource Card.Standard}" Padding="18"><StackPanel>
              <TextBlock Text="操作记录与隐私" Style="{StaticResource Text.SectionTitle}"/>
              <TextBlock Text="只显示命令、结果状态和时间，不显示任务标题或原始聊天内容。" Style="{StaticResource Text.Secondary}" Margin="0,5,0,10" TextWrapping="Wrap"/>
              <WrapPanel><Button Content="刷新最近操作" Click="RefreshAudit_Click" Margin="0,0,8,8"/><Button Content="清理本地审计记录" Click="ClearAudit_Click" Style="{StaticResource Button.Danger}" Margin="0,0,8,8"/></WrapPanel>
              <TextBlock x:Name="AuditEntries" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel></Border>
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="CancelButton" Content="取消" Click="Cancel_Click" Margin="0,0,8,0"/>
          <Button x:Name="SaveButton" Content="保存" Click="Save_Click" Style="{StaticResource Button.Primary}"/>
        </StackPanel>
      </Grid>
      <Border x:Name="SaveSuccessToast" Grid.RowSpan="2"
              Background="{DynamicResource Brush.Surface}"
              BorderBrush="{DynamicResource Brush.Accent}"
              BorderThickness="1" CornerRadius="14" Padding="14,10"
              Margin="24,0,24,70" MinWidth="176"
              HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Visibility="Collapsed" Opacity="0"
              IsHitTestVisible="False" Panel.ZIndex="50">
        <Border.Effect>
          <DropShadowEffect Color="#000000" ShadowDepth="3" BlurRadius="14" Opacity="0.28"/>
        </Border.Effect>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Width="26" Height="26" CornerRadius="13"
                  Background="{DynamicResource Brush.AccentSoft}">
            <TextBlock Text="✓" Foreground="{DynamicResource Brush.Accent}"
                       FontSize="14" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="设置已保存" Foreground="{DynamicResource Brush.TextPrimary}"
                       FontSize="13" FontWeight="SemiBold"/>
            <TextBlock Text="更改已应用" Foreground="{DynamicResource Brush.TextSecondary}"
                       FontSize="12" Margin="0,2,0,0"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
  </Grid>
</Window>
