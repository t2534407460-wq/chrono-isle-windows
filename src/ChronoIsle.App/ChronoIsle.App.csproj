<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ChronoIsle</AssemblyName>
    <RootNamespace>ChronoIsle.App</RootNamespace>
    <ApplicationIcon>Assets\face.ico</ApplicationIcon>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Identity.Client.Broker" Version="4.81.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.7" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="App.xaml.cs;GlobalAliases.cs;LifeModels.cs;MarkdownTextBlock.cs" />
    <Compile Include="Services\Domain\*.cs" />
    <Compile Include="Services\Persistence\*.cs" />
    <Compile Include="Services\Commanding\*.cs" />
    <Compile Include="Services\State\*.cs" />
    <Compile Include="Services\Productivity\*.cs" />
    <Compile Include="Services\Reporting\*.cs" />
    <Compile Include="Services\Sync\*.cs" />
    <Compile Include="Services\LifeDataService.cs;Services\ProviderSettingsService.cs;Services\OpenAiChatService.cs;Services\AutoStartService.cs;Services\LegacyDataMigration.cs;Services\MediaSessionService.cs;Services\LyricsService.cs;Services\FullscreenAvoidanceService.cs;Services\SystemTelemetryService.cs;Services\SystemToastInboxService.cs;Services\ThemeService.cs" />
    <Compile Include="Services\LifePreferencesService.cs;Services\DesktopMusicSessionDetector.cs;Services\AssistantIntentService.cs;Services\AssistantActionService.cs;Services\ReminderService.cs;Services\WindowsNotificationService.cs;Services\RecurringReminderData.cs;Services\SingleReminderData.cs;Services\ConversationRouter.cs;Services\LocalAgendaQueryService.cs;Services\LifeTrayService.cs;Services\ChinaStatutoryHolidayCalendar.cs" />
    <Compile Remove="Services\LifeDataService.cs;Services\RecurringReminderData.cs;Services\SingleReminderData.cs" />
    <Compile Remove="Services\ReminderService.cs" />
    <Compile Include="Services\StorageV2\*.cs" />
    <Compile Include="Services\Scheduling\*.cs" />
    <Compile Include="Services\SchedulingV2\*.cs" />
    <Compile Include="ViewModels\LifeViewModel.cs" />
    <Compile Include="Views\LifeMainWindow.xaml.cs;Views\LifeSettingsWindow.xaml.cs;Views\LifeIslandWindow.xaml.cs;Views\LifeManagementWindow.xaml.cs;Views\NamingWindow.xaml.cs;Views\TrayMenuWindow.xaml.cs;Views\IslandWindowStyles.cs" />
  </ItemGroup>
  <ItemGroup>
    <ApplicationDefinition Include="App.xaml" />
    <Page Include="Views\LifeMainWindow.xaml;Views\LifeSettingsWindow.xaml;Views\LifeIslandWindow.xaml;Views\LifeManagementWindow.xaml;Views\NamingWindow.xaml;Views\TrayMenuWindow.xaml" />
    <Page Include="Resources\DesignTokens.xaml" />
    <Page Include="Resources\Controls.xaml" />
    <Page Include="Resources\Components.xaml" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\face.ico" />
    <Resource Include="Assets\island-mascot.png" />
  </ItemGroup>
</Project>
