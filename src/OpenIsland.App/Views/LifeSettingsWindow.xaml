<Window x:Class="OpenIsland.App.Views.LifeSettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Island &#x8BBE;&#x7F6E;" Width="580" Height="520" Background="#171719" Foreground="#F5F5F7" FontFamily="Segoe UI Variable" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer><StackPanel>
      <TextBlock Text="设置" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,20"/>
      <Border Background="#242428" CornerRadius="12" Padding="18" Margin="0,0,0,14"><StackPanel>
        <TextBlock Text="AI 模型" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="DeepSeek 为默认预设，也兼容 OpenAI 格式服务。" Foreground="#A5A5AB" Margin="0,5,0,16"/>
        <TextBlock Text="Base URL"/><TextBox x:Name="Url" Margin="0,5,0,12" Padding="8"/>
        <TextBlock Text="模型"/><TextBox x:Name="Model" Margin="0,5,0,12" Padding="8"/>
        <TextBlock Text="API Key"/><PasswordBox x:Name="Key" Margin="0,5,0,12" Padding="8"/>
        <StackPanel Orientation="Horizontal"><Button Content="测试连接" Click="Test_Click" Padding="14,7"/><TextBlock x:Name="Result" Foreground="#9DD69D" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/></StackPanel>
      </StackPanel></Border>
      <Border Background="#242428" CornerRadius="12" Padding="18"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel>
        <TextBlock Text="通用" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="Windows 通知" FontSize="14" Margin="0,14,0,2"/><TextBlock Text="待办与日程到期时发送系统通知，并同步在灵动岛中提示。" Foreground="#A5A5AB" TextWrapping="Wrap"/>
        <TextBlock Text="开机自启" FontSize="14" Margin="0,14,0,2"/><TextBlock x:Name="AutoStartStatus" Foreground="#A5A5AB" TextWrapping="Wrap"/>
      </StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><CheckBox x:Name="WindowsNotifications" Margin="0,0,0,20"/><CheckBox x:Name="AutoStart" Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"/></StackPanel></Grid></Border>
    </StackPanel></ScrollViewer>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="取消" Click="Cancel_Click" Padding="16,8" Margin="0,0,8,0"/><Button Content="保存" Click="Save_Click" Padding="16,8"/></StackPanel>
  </Grid>
</Window>
