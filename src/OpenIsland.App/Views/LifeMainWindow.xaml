<Window x:Class="OpenIsland.App.Views.LifeMainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:OpenIsland.App" Title="Island" Width="900" Height="650" MinWidth="700" MinHeight="480" Background="#1C1C1E" Foreground="#F2F2F7" FontFamily="Microsoft YaHei UI, Segoe UI Variable" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible"/>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#0A84FF"/><Setter Property="Foreground" Value="#FFF"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/></Style>
    <Style x:Key="DeleteIcon" TargetType="Button"><Setter Property="Background" Value="#3A3A3E"/><Setter Property="Foreground" Value="#FF7878"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="DeleteSurface" Background="{TemplateBinding Background}" CornerRadius="7"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DeleteSurface" Property="Opacity" Value=".8"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="DeleteSurface" Property="Opacity" Value=".65"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="ConfirmButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#7CC47F"/><Setter Property="Foreground" Value="#102514"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  </Window.Resources>
  <Grid Margin="20"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#242426" CornerRadius="14" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock Text="Island" FontSize="21" FontWeight="Bold"/>
      <Grid Grid.Row="1" Margin="0,16,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="＋ 新对话" Command="{Binding NewChatCommand}" Style="{StaticResource PrimaryButton}"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="管理" Click="Manage_Click" Style="{StaticResource GhostButton}" Margin="0,0,8,0"/><Button Content="设置" Click="Settings_Click" Style="{StaticResource GhostButton}" Margin="0"/></StackPanel></Grid>
      <ListBox Grid.Row="2" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Title}" Width="128" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/><Button Width="26" Height="26" Margin="6,0,0,0" Command="{Binding DataContext.DeleteChatCommand,RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource DeleteIcon}" ToolTip="删除对话"><TextBlock Text="&#xD7;" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></Button></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
    </Grid></Border>
    <Border Grid.Column="2" Background="#242426" CornerRadius="14" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel><TextBlock Text="对话" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Status}" FontSize="12" Foreground="#98989D" Margin="0,4,0,0"/></StackPanel>
      <ListBox Grid.Row="1" ItemsSource="{Binding Messages}" Margin="0,16,0,12" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border Background="#2C2C2E" CornerRadius="10" Padding="14" Margin="0,0,0,10"><StackPanel><TextBlock Text="{Binding Role}" FontSize="11" Foreground="#98989D" Margin="0,0,0,5"/><local:MarkdownTextBlock Markdown="{Binding Content}"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
      <Border Grid.Row="2" Background="#1E2B22" BorderBrush="#426548" BorderThickness="1" CornerRadius="11" Padding="13" Margin="0,0,0,12" Visibility="{Binding HasPendingAction,Converter={StaticResource Visible}}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="确认创建" Foreground="#9DD69D" FontWeight="SemiBold"/><TextBlock Text="{Binding PendingActionText}" TextWrapping="Wrap" Margin="0,5,12,0" Foreground="#E5E5EA"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="取消" Command="{Binding CancelPendingActionCommand}" Style="{StaticResource GhostButton}" Margin="0,0,7,0"/><Button Content="确认创建" Command="{Binding ConfirmPendingActionCommand}" Style="{StaticResource ConfirmButton}"/></StackPanel></Grid></Border>
      <DockPanel Grid.Row="3"><Button Content="发送" Command="{Binding SendCommand}" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Width="72" MinHeight="40" Margin="10,0,0,0"/><TextBox x:Name="ChatInputBox" Text="{Binding ChatInput,UpdateSourceTrigger=PropertyChanged}" MinHeight="40" MaxHeight="120" AcceptsReturn="True" TextWrapping="Wrap" TextChanged="ChatInput_TextChanged" VerticalContentAlignment="Center"/></DockPanel>
    </Grid></Border>
  </Grid>
</Window>
